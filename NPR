      <description>&lt;div id="storytext" class="storytext storylocation linkLocation"&gt;       &lt;div id="resg-s1-152345" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 3000;         --source-height: 2000;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/1800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/1800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/1100/quality/50/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3000x2000+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F89%2F45%2Fec329b15426b8f905036518cfcae%2Fdems-senate-history.jpg" class="img" alt="Josh Turek, Peggy Flanagan, and Dr. Abdul El-Sayed are among several Democratic Senators-elect who made history on Election Day 2026." fetchpriority="high" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Josh Turek, Peggy Flanagan, and Dr. Abdul El-Sayed are among several Democratic Senators-elect who made history on Election Day 2026.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Scott Olson/Getty Images; Dymanh Chhoun/Sahan Journal/CatchLight via Getty Images; Sylvia Jarrus for NPR                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;When the newest class of U.S. senators are sworn into office in January, it will include &lt;a href="https://www.npr.org/2026/11/04/nx-s1-6028546/governor-candidates-history-election-2026" target="_blank"&gt;some of America's firsts&lt;/a&gt;.&lt;/p&gt;   &lt;div id="resnx-s1-6032814-100" class="bucketwrap internallink insettwocolumn inset2col"&gt;                     &lt;!-- END CLASS="BUCKET IMG" --&gt;    &lt;/div&gt;     &lt;!-- END ID="RESNX-S1-6032814-100" CLASS="BUCKETWRAP INTERNALLINK INSETTWOCOLUMN INSET2COL " --&gt;    &lt;p&gt;The 2026 midterm election resulted in a significant shift in the landscape of Congress as Democrats won in a big way up and down the ballot. While not all the races have been called, Democrats have flipped more than 40 House seats and picked up 7 Senate seats, giving them control of both chambers of Congress.&lt;/p&gt;   &lt;p&gt;Here are some of the new faces to expect in the Senate who made history on Election Day.&lt;/p&gt;   &lt;h3 class="edTag"&gt;&lt;strong&gt;Josh Turek of Iowa &lt;/strong&gt;&lt;/h3&gt;   &lt;div id="resg-s1-152346" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 5797;         --source-height: 3865;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5797x3865+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5797x3865+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg 600w, https://npr.bri