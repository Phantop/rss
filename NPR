ms3/default/strip/false/crop/853x1280+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fdf%2F4e%2F14f94c5e47909b4a5ad3c181fdd2%2Fimg-9936-1.jpg" sizes="(min-width: 1350px) 298px, (min-width: 1025px) calc(((100vw - 365px)/3) - 30px), (min-width: 768px) calc(((100vw - 30px)/3) - 30px), calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/853x1280+0+0/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fdf%2F4e%2F14f94c5e47909b4a5ad3c181fdd2%2Fimg-9936-1.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/853x1280+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fdf%2F4e%2F14f94c5e47909b4a5ad3c181fdd2%2Fimg-9936-1.jpg" class="img" alt="Nicole Wright on violin while Tiffany Goode plays the trumpet at the ensemble’s D.C. performance." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Nicole Wright on violin while Tiffany Goode plays the trumpet at the ensemble's D.C. performance.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Andre Calder                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Davis takes a similar full-body approach. He listens to the repertoire while driving, catching details such as notes he may have missed in previous runs. He also exercises four to five times a week — including weightlifting workouts and walking.&lt;/p&gt;   &lt;p&gt;Focusing on his endurance on stage is vital — since each Orchestra Noir performance demands a high level of stamina due to the ensemble's musicians performing choreography while also playing their instruments.&lt;/p&gt;   &lt;p&gt;"Taking care of myself physically helps me when it's time to perform. It also gives me a chance to clear my mind and stay disciplined," Davis said.&lt;/p&gt;       &lt;p&gt;On performance days, pre-show rituals also keep the musicians grounded. Davis plays long tones on his saxophone — sustaining single notes to center his breath and tone. Wright practices specific musical cues, calls her mother and will try on dresses until she finds the perfect one to wear on stage. And both of them remember to pray.&lt;/p&gt;   &lt;p&gt;"Me and God are walking the entire time together," Wright said with a laugh.&lt;/p&gt;   &lt;h3 class="edTag"&gt;&lt;strong&gt;A night to remember&lt;/strong&gt;&lt;/h3&gt;   &lt;p&gt;By the time the lights go down, the audience inside Warner Theatre is already buzzing with excitement.&lt;/p&gt;   &lt;p&gt;Orchestra Noir takes the stage in custom black-and-red letterman jackets that feature red-and-black sleeves with the letters "ATL" stitched on the right.&lt;/p&gt;   &lt;div id="resg-s1-154650" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 1024;         --source-height: 1024;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1024x1024+0+256/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F3e%2F9a%2F4e76e9264e94a7f699aa8532eb11%2Faction-shot.png" class="img" alt="Orchestra Noir founder, Jason Ikeem Rodgers conducts the band while they wear their custom black-and-red letter jackets." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Orchestra Noir founder, Jason Ikeem Rodgers conducts the band while they wear their custom black-and-red letter jackets.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Andre Calder                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;They open with Usher's 2004 hit "Yeah!" — with musicians rushing in from both ends of the stage and smoke sprouting up from the stage floor.&lt;/p&gt;   &lt;p&gt;When an electric guitar joins the orchestra for Jagged Edge's "Where the Party at," the room shifts even higher. Then comes Ciara's "Like a Boy" — which features a violin solo from Wright that she plays so intensely that her bow snaps mid-solo.&lt;/p&gt;   &lt;p&gt;Orchestra Noir closes the night with Lil Boosie's "Wipe Me Down." By this point, nearly the whole crowd is standing, with several audience members already making their way towards the stage.&lt;/p&gt;   &lt;p&gt;As a part of their post-show ritual, the musicians come to the end of the stage to meet the people who came out to hear them perform. It is a cherished tradition that makes them feel even closer to the multigenerational audience supporting them from city to city.&lt;/p&gt;   &lt;p&gt;"[During the 2025 season] out in California, someone in the audience came and cried," Davis recalled. "They just moved to Cali and haven't had anything for them — and then seeing us made that huge difference for them. So, it's a great thing. It's a blessing."&lt;/p&gt;       &lt;p&gt;"We're being seen. We have something to say," he added. "Younger folk, older folk — they can say, okay, we see Black people playing in orchestras. Which is a serious thing." &lt;/p&gt;   &lt;div id="resg-s1-154652" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 2048;         --source-height: 1365;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2048x1365+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F6d%2F19%2F25ead23f4666a1e7929803e93f71%2Ftabernacleatl-20230826-3529.jpg" class="img" alt="Rhandal Jackson and Tiffany Goode play the trumpet." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Rhandal Jackson and Tiffany Goode play the trumpet.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Andre Calder                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;For Wright, who grew up in Brownsville, Brooklyn, the ensemble has built a musical bridge she always wished existed.&lt;/p&gt;   &lt;p&gt;"When I stepped outside, I was hearing Beyoncé or Brandy," she said. "But when I was practicing in the house, I was practicing Vivaldi." "We come to the edge of the stage, we can meet as many audience members as we can and we talk to them," Wright said. "Some of their children are playing the violin or the viola, and they'll ask us to take a picture or they'll ask us to make a video to inspire their daughter. Because sometimes when their daughter is practicing, they don't get to see the end result. Because practicing can take quite a bit of time. So they want us to show their daughters and send these videos to them to help inspire them."&lt;/p&gt;   &lt;p&gt;"My goal is making sure [audience members] leave feeling something awesome or something great," Wright added. "And that's what we're doing. We treat every show as if it's our last."&lt;/p&gt; &lt;/div&gt;</description>
