      <description>&lt;div id="storytext" class="storytext storylocation linkLocation"&gt;       &lt;div id="resg-s1-155291" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 5714;         --source-height: 3802;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5714x3802+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ffb%2F9c%2F9713cdb545dbb1fb84bae3122894%2Fgettyimages-2272594799.jpg" class="img" alt="This graphic illustration shows a person&amp;#039;s brain surrounded by flowers, against a yellow background." fetchpriority="high" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 The risk for dementia, long thought to be an accident of genes or luck, can be cut with commonsense lifestyle interventions.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Raquel Alvarez Tabernero/iStockphoto/Getty Images                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;&lt;em&gt;Follow the &lt;/em&gt;&lt;a href="https://www.npr.org/newsletter/your-turn" target="_blank"&gt;Your Turn&lt;em&gt; newsletter&lt;/em&gt;&lt;/a&gt;&lt;em&gt; and listen to the &lt;/em&gt;&lt;a href="https://www.npr.org/podcasts/g-s1-143389/your-turn-with-allison-aubrey" target="_blank"&gt;Your Turn&lt;em&gt; podcast&lt;/em&gt;&lt;/a&gt;&lt;em&gt; on the NPR app or wherever you get your podcasts.&lt;/em&gt;&lt;/p&gt;   &lt;p&gt;It's one of the biggest fears about getting older: losing your memory. A growing body of evidence shows we can do a lot to lower the risk of dementia, starting with changes to our day-to-day habits.&lt;/p&gt;   &lt;p&gt;For decades, dementia was seen as something determined by genes or bad luck: a disease that strikes late in life with little anyone can do about it. That thinking has radically changed.&lt;/p&gt;       &lt;div id="resnx-s1-6050867-100" class="bucketwrap internallink insettwocolumn inset2col"&gt;                     &lt;!-- END CLASS="BUCKET IMG" --&gt;    &lt;/div&gt;     &lt;!-- END ID="RESNX-S1-6050867-100" CLASS="BUCKETWRAP INTERNALLINK INSETTWOCOLUMN INSET2COL " --&gt;    &lt;p&gt;In 2024, the Lancet Commission, an international panel of experts, identified 14 modifiable risk factors for dementia and estimated that about &lt;a href="https://www.thelancet.com/commissions-do/dementia-prevention-intervention-and-care" target="_blank"&gt;45% of dementia cases could be prevented&lt;/a&gt; or delayed. And lifestyle changes, when sustained over time, can be a powerful form of prevention. Last year, a large clinical trial from the Alzheimer's Association, called &lt;a href="https://www.alz.org/us-pointer" target="_blank"&gt;U.S. POINTER&lt;/a&gt;, found that older adults at risk of cognitive decline who combined physical activity, healthy eating, cognitive exercises and social activity could protect brain health, thinking and memory.&lt;/p&gt;   &lt;h3 class="edTag"&gt;A score for your brain&lt;/h3&gt;   &lt;p&gt;So where do you start? One good place is a free, five-minute online tool called the &lt;a href="https://globalbraincare.org/" target="_blank"&gt;Brain Care Score&lt;/a&gt;. You can take it with friends and family members as you gather for the holidays.&lt;/p&gt;   &lt;div id="resnx-s1-6050867-101" class="bucketwrap internallink insettwocolumn inset2col"&gt;                     &lt;!-- END CLASS="BUCKET IMG" --&gt;    &lt;/div&gt;     &lt;!-- END ID="RESNX-S1-6050867-101" CLASS="BUCKETWRAP INTERNALLINK INSETTWOCOLUMN INSET2COL " --&gt;    &lt;p&gt;It was developed by Jonathan Rosand, a neurologist at Massachusetts General Hospital, and his colleagues. It's now supported through the Global Brain Care Coalition.&lt;/p&gt;   &lt;p&gt;"The Brain Care Score tells you how to reduce your risk of brain diseases in the future, especially dementia, stroke and depression," Rosand says. "And it tells you what you can do to live a longer, more flourishing life."&lt;/p&gt;   &lt;p&gt;The score covers 12 factors in three areas. The higher your score, the lower your risk. Those factors are:&lt;br&gt;&lt;/p&gt;       &lt;aside id="mid-story-recommendations-mount-piano" class="mid-story-recommendations-mount-piano" aria-label="recommended stories"&gt;&lt;/aside&gt;    &lt;!-- END ID="MID-STORY-RECOMMENDATIONS-MOUNT-PIANO" CLASS="MID-STORY-RECOMMENDATIONS-MOUNT-PIANO" ARIA-LABEL="RECOMMENDED STORIES" --&gt;    &lt;ul class="edTag rte2-style-ul"&gt;&lt;li&gt;&lt;strong&gt;Physical health:&lt;/strong&gt; blood pressure, blood sugar, cholesterol and body weight&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Lifestyle:&lt;/strong&gt; diet, exercise, sleep, smoking and alcohol&lt;br&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Social and emotional health:&lt;/strong&gt; stress management, relationships and a sense of purpose&lt;/li&gt;&lt;/ul&gt;   &lt;p&gt;According to the coalition, the tool, "wasn't built to label risk. It was built to give people options and to show them that small changes made today can matter years from now."&lt;/p&gt;   &lt;h3 class="edTag"&gt;Why blood pressure matters for your brain&lt;/h3&gt;   &lt;p&gt;High blood pressure might seem like a heart issue, but it's one of the biggest risk factors for dementia, and many people don't know their numbers.&lt;/p&gt;   &lt;p&gt;"The higher your blood pressure, the more stress on your blood vessels," Rosand explains. "The more stress on your blood vessels, the more they break down over time," and the more they break down, the more likely they are to block or rupture. He says high blood pressure can increase the risk of stroke and dementia.&lt;/p&gt;   &lt;p&gt;That's why the first step in calculating your score is to know your numbers: blood pressure, blood sugar (measured as A1c), cholesterol and body weight. You can ask your healthcare provider, check your patient portal or use a blood pressure cuff at a pharmacy. If you've been prescribed medication for high blood pressure, he says, taking the medicine is one of the most important things you can do.&lt;/p&gt;   &lt;h3 class="edTag"&gt;Small gains add up&lt;/h3&gt;   &lt;p&gt;What if you take the quiz and don't love your number? The whole point of knowing your score is to use it as an assessment, a place to begin and a way to strategize about what changes you can make to your daily lifestyle habits. There's no need to overhaul your life.&lt;/p&gt;   &lt;p&gt;In an analysis of real-world data from thousands of adults, each one-point improvement in the Brain Care Score was linked to up to a 4% lower risk of dementia, stroke or late-life depression. And even people who change their habits late in life can benefit.&lt;/p&gt;       &lt;div id="resnx-s1-6050867-102" class="bucketwrap internallink insettwocolumn inset2col"&gt;                     &lt;!-- END CLASS="BUCKET IMG" --&gt;    &lt;/div&gt;     &lt;!-- END ID="RESNX-S1-6050867-102" CLASS="BUCKETWRAP INTERNALLINK INSETTWOCOLUMN INSET2COL " --&gt;    &lt;p&gt;The key is to pick one change that feels doable, such as:&lt;/p&gt;   &lt;ul class="edTag rte2-style-ul"&gt;&lt;li&gt;Adding 30 minutes of sleep to your daily routine if you're not well rested&lt;/li&gt;&lt;li&gt;Putting an extra serving of greens on your plate&lt;/li&gt;&lt;li&gt;Adding in a 20-minute walk each day and resistance bands for strength training&lt;/li&gt;&lt;li&gt;Calling a friend to get together or joining a group activity&lt;/li&gt;&lt;li&gt;Getting your blood pressure checked&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;   &lt;p&gt;Researchers say one healthy change often leads to others. Better sleep, for example, can make it easier to exercise and eat well, so the benefits can multiply across the score.&lt;/p&gt;   &lt;h3 class="edTag"&gt;Purpose and connection count too&lt;/h3&gt;   &lt;p&gt;One part of the score that surprises people is the value placed on relationships and purpose. A 2025 study found that people with a higher sense of purpose were about 28% less likely to develop cognitive impairment.&lt;/p&gt;   &lt;p&gt;That means joining the class or the volunteer gig you've been putting off can be considered a form of brain care.&lt;/p&gt;   &lt;p&gt;You can retake the quiz over time to track your progress, and you can share it with family and friends. Healthy habits can be contagious.&lt;/p&gt; &lt;/div&gt;</description>
      <media:content url="https://ondemand.npr.org/anon.npr-mp3/npr/me/2026/11/20261127_me_12_strategies_to_cut_your_risk_of_dementia._take_this_quiz_to_start.mp3?t=progseg&amp;amp;e=nx-s1-6011274&amp;amp;p=3&amp;amp;seg=8&amp;amp;d=207&amp;amp;size=3316969&amp;amp;sc=siteplayer&amp;amp;aw_0_1st.playerid=siteplayer" type="audio/mpeg"/>
      <media:content url="https://www.npr.org/transcripts/nx-s1-6050867" type="application/octet-stream"/>
