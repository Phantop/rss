ze/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fdf%2F21%2F42d1803c45cb9230ca1b1bd6a953%2Fsheep-midday-close1.jpg" class="img" alt="A work by Thomas in Flagstaff, Arizona." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 2015 installation on concrete remains of old Cow Springs Trading Post, Cow Springs, Az.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          &lt;a   href="https://jetsonorama.net/" class="Link"  target="_blank"   &gt;jetsonorama&lt;/a&gt;                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;div id="resg-s1-148254" class="bucketwrap image x-large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 4000;         --source-height: 2667;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7b