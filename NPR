1fe6ce0939%2Fgettyimages-2302915246.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5349x3566+0+0/resize/1800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fce%2F9f%2F56f1741c4d41bd69981fe6ce0939%2Fgettyimages-2302915246.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5349x3566+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fce%2F9f%2F56f1741c4d41bd69981fe6ce0939%2Fgettyimages-2302915246.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5349x3566+0+0/resize/1100/quality/50/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fce%2F9f%2F56f1741c4d41bd69981fe6ce0939%2Fgettyimages-2302915246.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5349x3566+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fce%2F9f%2F56f1741c4d41bd69981fe6ce0939%2Fgettyimages-2302915246.jpg" class="img" alt="Peggy Flanagan walks with her husband as they arrive to vote at a polling location on Election Day in St. Louis Park, Minn. on November 3, 2026." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Peggy Flanagan walks with her husband as they arrive to vote at a polling location on Election Day in St. Louis Park, Minn. on November 3, 2026.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Tim Evans/AFP via Getty Images                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;    