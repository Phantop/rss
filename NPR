      <description>&lt;div id="storytext" class="storytext storylocation linkLocation"&gt;       &lt;div id="resg-s1-145639" class="bucketwrap image x-large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 5400;         --source-height: 3038;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5400x3038+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fdb%2F57%2F7e552025480485d0276789624ba8%2Ffoster-care-voices-update.png 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5400x3038+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fdb%2F57%2F7e552025480485d0276789624ba8%2Ffoster-care-voices-update.png 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5400x3038+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fdb%2F57%2F7e552025480485d0276789624ba8%2Ffoster-care-voices-update.png 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5400x3038+0+0/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fdb%2F57%2F7e552025480485d0276789624ba8%2Ffoster-care-voices-update.png 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5400x3038+0+0/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fdb%2F57%2F7e552025480485d0276789624ba8%2Ffoster-care-voices-update.png 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5400x3038+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fdb%2F57%2F7e552025480485d0276789624ba8%2Ffoster-care-voices-update.png 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5400x3038+0+0/resize/1800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fdb%2F57%2F7e5520254