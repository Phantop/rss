7baf4d7d8%2Fimg-9831.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/900/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/1200/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg 1800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/2400/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg 2400w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg" sizes="(min-width: 1350px) 953px, (min-width: 1025px) calc(100vw - 395px), (min-width: 768px) calc(100vw - 60px), calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2667+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F12%2F37%2F5ffe1bc143b5864d16c7baf4d7d8%2Fimg-9831.jpg" class="img" alt="A work by Thomas in Flagstaff, Arizona." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Thomas places his work on buildings near highways that traverse the Navajo Nation. This 2025 work is visible from US Highway 160, at the abandoned Black Mesa Shopping Center, west of Kayenta, Az.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Adam Burke/KSUT                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Every photograph is a window, every camera, a mirror. Chip Thomas uses his lens, his work, to reflect the beauty and resilience of the people who live on this land.&lt;/p&gt;       &lt;p&gt;He's put up work outside of his home ground, with commissions in Cincinnati, North Carolina, Oakland and Philadelphia. Now he's a MacArthur fellow. But at 69, he says he's not done yet.&lt;/p&gt;   &lt;p&gt;"It's still a passion play for me," Thomas said. "To create new work, tell new stories and I like to do it in a way that engages people. My primary audience for the work on the Navajo Nation is Navajo people. And I'd like to think that there will be continued growth in the work that I create."&lt;/p&gt;   &lt;p&gt;That work will almost certainly be big and bold, like the land itself–visions that materialize for a short while, and then gradually dissolve again, into the desert.&lt;br&gt;&lt;/p&gt; &lt;/div&gt;</description>
