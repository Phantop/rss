      <description>&lt;div id="storytext" class="storytext storylocation linkLocation"&gt;       &lt;div id="resg-s1-150688" class="bucketwrap image x-large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 8000;         --source-height: 5328;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/1000/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 1000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/1300/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 1300w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/2000/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 2000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/2600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 2600w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg" sizes="(min-width: 1300px) 1238px, (min-width: 1025px) calc(100vw - 60px), (min-width: 768px) calc(100vw - 60px), calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/1000/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 1000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/1300/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 1300w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/2000/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 2000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/2600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg 2600w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg" sizes="(min-width: 1300px) 1238px, (min-width: 1025px) calc(100vw - 60px), (min-width: 768px) calc(100vw - 60px), calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/1100/quality/50/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8000x5328+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F60%2Fdd%2F7ca94032447789d52228608bf99e%2Fnc-shipbreaking-on-the-mudflats-bay-of-bengal-george-steinmetz.jpg" class="img" alt="An old LNG carrier in the final stage of disassembly for scrap metal on the mudflats of the Bay of Bengal, just north of Chattogram, Bangladesh. Breaking a ship like this will take about a year, with a crew of 60 men using blow torches and winches to drag the larger pieces ashore for cutting into smaller pieces. The nearby BSRM smelter melts down the scrap metal from the old boats and produces rebar and rolled steel, while the more valuable non-ferrous metals are sold overseas. The brass from this ship was sold to Hyundai, the ship’s manufacturer in Korea, for use in new ships. From this LNG ship, they will collect a total of 30k tons of metal, plus 2.4k tons of aluminum and 200-300 tons of brass, copper, and stainless steel. Bangladesh has no iron mines and relies on shipbreaking for much of its iron and steel. Shipbreaking requires low wages and high demand for scrap steel. LNG boats are more valuable as they have large quantities of non-ferrous metals that fetch higher prices. Bangladesh had 160 shipbreaking yards before the June 2025 regulation requiring that all new ship purchases after that date be broken using “green methods” requiring international certifications. This forced most of the shipbreakers out of business, and now there are only 10 active shipbreaking yards. The green regulations require a US$4-5 million investment in a thick concrete slab for breaking work, a crane, and toxic liquid storage tanks, as well as higher wages and international certifications. resulting in higher operating costs. This LNG ship was purchased before the June 2025 green deadline. The world’s biggest ship-breaking areas are in Alang, India; #2 is Bangladesh; #3 is Pakistan; and they are all now subject to the same standards. This old-style ship-breaking operation is being done in a rented yard and run by Marine Safety System, but its owner, Mr. Kamal Ahamad, doesn’t want his name or the company’s name mentioned in captions. Kamal works in Bangla" fetchpriority="high" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 It's a mega-recycling effort: A crew of 60 men use blow torches and winches to break down a ship that had carried liquid natural gas. Tons of metal parts will be harvested to resell overseas. This photo by George Steinmetz, from the Bay of Bengal in Bangladesh, is the overall winner in the 2026 Siena Drone Photo Awards contest.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          George Steinmetz                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;It looks like a spacecraft that settled gently onto a golden beach.&lt;/p&gt;   &lt;p&gt;Off the coast of Bangladesh, an enormous vessel lies stranded on the mudflats, its steel hull partially dismantled as workers mill around it. This unusual aerial view of a tanker, specially designed to transport liquified natural gas used for cooking, electricity and transport, won photographer &lt;a href="https://www.georgesteinmetz.com/" target="_blank"&gt;&lt;u&gt;George Steinmetz&lt;/u&gt;&lt;/a&gt; the top prize — &lt;a href="https://droneawards.photo/gallery" target="_blank"&gt;&lt;u&gt;overall winner of the 2026 Siena Drone Photo Awards.&lt;/u&gt;&lt;/a&gt;&lt;/p&gt;   &lt;p&gt;Each year, the Siena Drone Photo Awards highlight bird's-eye views of our planet, revealing landscapes, livelihoods and human stories often invisible from the ground. Here, we've selected some of this year's winning and highly commended photographs, focusing on the countries of the Global South.&lt;/p&gt;       &lt;p&gt;In an interview with NPR, Steinmetz says he's been long fascinated by Bangladesh's shipbreaking industry, where enormous vessels from around the globe, nearing the end of their working lives, are dismantled and their materials recovered for reuse. The photograph is titled "Shipbreaking on the mudflats, Bay of Bengal." Steinmetz sent up his drone north of Chattogram (Chittagong), along this 13-mile coastal strip, offering a stark glimpse into what this industry is like.&lt;/p&gt;   &lt;p&gt;He was exploring the relationship between human populations and the environment for a book project and saw the industry as an extraordinary example of recycling on a vast scale.&lt;/p&gt;   &lt;p&gt;Photographing it proved surprisingly difficult. The ship breaking industry has faced criticism from environmental organizations, human rights groups, labor unions and non-governmental organizations for its unchecked pollution, the leeching of chemicals into the sea and &lt;a href="https://www.hrw.org/news/2023/09/27/bangladesh-shipping-firms-profit-labor-abuse" target="_blank"&gt;&lt;u&gt;dangerous working conditions&lt;/u&gt;&lt;/a&gt;. Shipyard owners are wary of journalists and photographers. Local photographers initially warned Steinmetz that securing access might be nearly impossible.&lt;/p&gt;   &lt;p&gt;Undeterred, he surveyed and photographed the entire coastline north of Chattogram with his drone, searching for a vessel that would make an especially striking photograph. He eventually settled on the liquid natural gas tanker. "The trick for me was to find the right ship, that was in a really interesting state of disassembly. And these tankers are very unusual boats. It just looked weird, like some kind of a spaceship. It takes workers a long time to break it down. And then they have to wait for the tide to be right so they can pull the pieces ashore. They have big winches and boats that they use to get the stuff ashore."&lt;/p&gt;       &lt;aside id="mid-story-recommendations-mount-piano" class="mid-story-recommendations-mount-piano" aria-label="recommended stories"&gt;&lt;/aside&gt;    &lt;!-- END ID="MID-STORY-RECOMMENDATIONS-MOUNT-PIANO" CLASS="MID-STORY-RECOMMENDATIONS-MOUNT-PIANO" ARIA-LABEL="RECOMMENDED STORIES" --&gt;    &lt;p&gt;He was able to convince the owner of the tanker to allow him to photograph it. The timing of the drone photo was crucial. Steinmetz wanted to capture the vessel at low tide, when the surrounding mudflats were exposed and workers could be seen moving around its enormous hull. Their tiny figures would look like ants, giving viewers a sense of the ship's mammoth scale. He spent several days photographing the vessel, returning as the tides shifted and the workers continued to take the ship apart for scrap metal.&lt;/p&gt;   &lt;p&gt;After graduating from Stanford with a degree in geophysics in 1979, Steinmetz had first dreamed of photographing landscapes from above while hitchhiking across Africa, often traveling on the roofs of trucks.&lt;/p&gt;   &lt;p&gt;In 1996, National Geographic agreed to finance an aerial photography project around the Sahara, for which Steinmetz learned to fly a motorized paraglider. "It was like being in a flying lawn chair or [sitting on] the front of a spoon," he says. Drones have now completely transformed aerial photography, allowing photographers to capture the world from perspectives that were once difficult, expensive or impossible to achieve, Steinmetz says.&lt;/p&gt;   &lt;p&gt;Today, armed with a drone rather than a paraglider, he continues to explore how a view from the sky can reveal stories that remain invisible from the ground.&lt;/p&gt;   &lt;h3 class="edTag"&gt;&lt;strong&gt;Southern Turkey: Carpet Fields&lt;/strong&gt;&lt;/h3&gt;   &lt;div id="resg-s1-150685" class="bucketwrap image x-large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 5276;         --source-height: 3518;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/1000/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 1000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/1300/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 1300w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/2000/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 2000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/2600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 2600w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg" sizes="(min-width: 1300px) 1238px, (min-width: 1025px) calc(100vw - 60px), (min-width: 768px) calc(100vw - 60px), calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/1000/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 1000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/1300/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 1300w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/2000/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 2000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/2600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg 2600w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg" sizes="(min-width: 1300px) 1238px, (min-width: 1025px) calc(100vw - 60px), (min-width: 768px) calc(100vw - 60px), calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/1100/quality/50/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5276x3518+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffd%2F70%2F4c3ba400404da61f7f7562b1600a%2Fnc-carpet-fields-f-dilek-yurdakul.jpg" class="img" alt="" loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Fields of handwoven carpets transform into a visual tapestry, laid out under the sun to dry. The weeks, even months, of exposure to intense sunlight gives handmade rugs their immensely sought-after, softly faded colors.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          &lt;h2 class=""&gt;F. Dilek Yurdakul&lt;/h2&gt;                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Why would anyone spread hundreds of beautiful carpets across open fields, leaving them exposed to a blazing Mediterranean sun for weeks or even months?&lt;/p&gt;   &lt;p&gt;In southern Türkiye, this is part of a traditional process that gives handmade rugs their immensely sought-after, softly faded colors. Under the intense sunlight, the vibrant reds, blues and other hues gradually mellow into glowing, muted tones.&lt;/p&gt;   &lt;p&gt;For Ankara-based &lt;a href="https://www.dilekyurdakul.com/about" target="_blank"&gt;&lt;u&gt;documentary photographer&lt;/u&gt;&lt;/a&gt; and lawyer Dilek Yurdakul, the drone was not simply a technical choice. It was an essential storytelling tool. "I wanted to create an image that first attracts the viewer through its beauty but then invites them to look deeper, to discover the people, traditions and cultural memory behind it," she says. The photograph won first place in the contest's People section.&lt;/p&gt;       &lt;p&gt;Yurdakul traveled six hours in blistering heat from Ankara to the Döşemealtı district of Antalya to capture this spectacle. "The first sight was astonishing. The fields were far larger than I had imagined. Thousands of carpets and kilims in different colors, sizes and patterns stretched across an enormous landscape," she says. From above, the carpets resemble a giant patchwork quilt, almost as if melded together, but her photograph captures the shadows between these slices of color.&lt;/p&gt;   &lt;p&gt;The aerial perspective allowed her to bring together several layers of the story in a single frame, she says: the artistic richness of Anatolian craftsmanship, the scale of the landscape and the human labor that connects them.&lt;/p&gt;   &lt;p&gt;"For me, this was a visual metaphor for the invisibility of labor. In many societies, the people whose work sustains everyday life remain largely unseen and unrecognized."&lt;/p&gt;   &lt;h3 class="edTag"&gt;&lt;strong&gt;East Java, Indonesia: &lt;/strong&gt;Tumpak Sewu's Majestic Waterfall&lt;/h3&gt;   &lt;div id="resg-s1-150690" class="bucketwrap image x-large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 4000;         --source-height: 3000;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x3000+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F75%2Fc3%2Fe8a03c2e40d59ec63338b96ca3d8%2Fnc-tumpak-sewu-s-majestic-waterfall-colas-decloitre.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x3000+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F75%2Fc3%2Fe8a03c2e40d59ec63338b96ca3d8%2Fnc-tumpak-sewu-s-majestic-waterfall-colas-decloitre.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x3000+0+0/resize/1000/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F75%2Fc3%2Fe8a03c2e40d59ec63338b96ca3d8%2Fnc-tumpak-sewu-s-majestic-waterfall-colas-decloitre.jpg 1000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x3000+0+0/resize/1300/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F75%2Fc3%2Fe8a03c2e40d59ec63338b96ca3d8%2Fnc-tumpak-sewu-s-majestic-waterfall-colas-decloitre.jpg 1300w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x3000+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F75%2Fc3%2Fe8a03c2e40d59ec63338b96ca3d8%2Fnc-tumpak-sewu-s-majestic-waterfall-colas-decloitre.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x3000+0+0/resize/2000/quality/85/format/webp/?url=http%3A%2F%2