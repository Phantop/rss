format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ff3%2Fef%2F8148beca415198acec3747193a08%2Fpluribus-photo-010301.jpg" class="img" alt="Rhea Seehorn as Carol in Pluribus." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Rhea Seehorn in &lt;em&gt;Pluribus.&lt;/em&gt;                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Apple TV                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;b class="toggle-caption"&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;             &lt;/b&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;HBO Max hit &lt;em&gt;The Pitt&lt;/em&gt; likely wins here. But &lt;a href="https://www.npr.org/2025/11/07/nx-s1-5597877/pluribus-apple-tv-review" target="_blank"&gt;Apple TV's &lt;em&gt;Pluribus&lt;/em&gt;&lt;/a&gt;&lt;em&gt; &lt;/em&gt;triumphs as a revolutionary sci-fi story; a virus, created with instructions sent from the stars, unites humanity in a giant hive mind, creating paradise or the largest cult in history. &lt;em&gt;— Eric Deggans&lt;/em&gt;&lt;/p&gt;       &lt;h3 class="edTag"&gt;&lt;strong&gt;Outstanding lead actor, drama: Noah Wyle, &lt;em&gt;The Pitt &lt;/em&gt;&lt;/strong&gt;&lt;/h3&gt;   &lt;div id="resg-s1-142790" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 1920;         --source-height: 1079;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1920x1079+0+