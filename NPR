tspotcdn.com/dims3/default/strip/false/crop/1600x793+0+0/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fba%2F1f%2F62a09ec3403da4102837c52cb256%2Fsage-bava-julieta-eugenio.png 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1600x793+0+0/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fba%2F1f%2F62a09ec3403da4102837c52cb256%2Fsage-bava-julieta-eugenio.png 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1600x793+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fba%2F1f%2F62a09ec3403da4102837c52cb256%2Fsage-bava-julieta-eugenio.png" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1600x793+0+0/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fba%2F1f%2F62a09ec3403da4102837c52cb256%2Fsage-bava-julieta-eugenio.png" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1600x793+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fba%2F1f%2F62a09ec3403da4102837c52cb256%2Fsage-bava-julieta-eugenio.png" class="img" alt="Sage Bava Julieta Eugenio.png" fetchpriority="high" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;         &lt;/div&gt;       &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;On this episode, we hear from two up-and-coming musicians who each left the bustle of the city behind in search of musical inspiration in nature. Vocalist and guitarist Sage Bava grew up on a 