0+0+0/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4496x3000+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff2%2Fe6%2F842c0c584574bebf383c85a84897%2Fap26330589214672.jpg" class="img" alt="Pedestrians shield themselves with umbrellas as they walk in the rain on Thanksgiving Day in New York, Thursday, Nov. 26, 2026." fetchpriority="high" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Pedestrians shield themselves with umbrellas as they walk in the rain on Thanksgiving Day in New York, Thursday, Nov. 26, 2026.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Yuki Iwamura/AP                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;A massive storm that stretched from the Midwest to Manhattan left almost a million people without power by Thanksgiving evening and disrupted holiday travel.&lt;/p&gt;   &lt;p&gt;More than 400 flights were cancelled and more than two thousand were delayed around the country on Thursday during one of the busiest travel times of the year. Driving was also made difficult by either heavy rains or snow and ice. Some 81.5 million people were expected to travel for the holiday between Thursday and Monday, according to &lt;a href="https://newsroom.aaa.com/2026/11/aaa-thanksgiving-holiday-travel-forecast/" target="_blank"&gt;&lt;u&gt;AAA&lt;/u&gt;&lt;/a&gt;.&lt;/p&gt;   &lt;p&gt;Power was partially restored early Friday, but at the peak of &lt;a href="https://poweroutage.us/" target="_blank"&gt;the outage&lt;/a&gt; more than 980,000 people in New York, Pennsylvania, New Jersey and elsewhere were without electricity. Missouri also suffered blackouts after heavy snowfall.&lt;/p&gt;   &lt;div id="resg-s1-156000" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 4910;         --source-height: 3274;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4910x3274+0+0/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F63%2F6a%2F