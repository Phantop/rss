ims3/default/strip/false/crop/5797x3865+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5797x3865+0+0/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5797x3865+0+0/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5797x3865+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5797x3865+0+0/resize/1800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5797x3865+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5797x3865+0+0/resize/1100/quality/50/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5797x3865+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F3a%2F1f01e0414dc3b55a3bd5b858dd3c%2Fap26308211570982.jpg" class="img" alt="Josh Turek speaks during an election night event Tuesday, Nov. 3, 2026, in Des Moines, Iowa." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Josh Turek speaks during an election night event Tuesday, Nov. 3, 2026, in Des Moines, Iowa.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Ellen Schmidt/AP                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Turek will be the first Paralympian to serve in the Senate. The Democrat is a two-time gold medalist in wheelchair basketball. Turek is paraplegic and uses a wheelchair due to spina bifida. He beat Republican Ashley Hinson in the general election.&lt;/p&gt;       &lt;h3 class="edTag"&gt;&lt;strong&gt;Julia Letlow of Louisiana &lt;/strong&gt;&lt;/h3&gt;   &lt;div id="resg-s1-152347" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 8139;         --source-height: 5426;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8139x5426+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F2e%2F44%2Fa0c105a9457e8ad979d165cae461%2Fap26137105498276.jpg 400w, https://npr.brightspotcdn.com/dims3/de