t/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fcc%2F04%2Fade23f264af7a6cc35f66b54eedb%2F2026-09-theastergates-atownsend-dsf2256.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fcc%2F04%2Fade23f264af7a6cc35f66b54eedb%2F2026-09-theastergates-atownsend-dsf2256.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fcc%2F04%2Fade23f264af7a6cc35f66b54eedb%2F2026-09-theastergates-atownsend-dsf2256.jpg 1800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/2400/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fcc%2F04%2Fade23f264af7a6cc35f66b54eedb%2F2026-09-theastergates-atownsend-dsf2256.jpg 2400w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fcc%2F04%2Fade23f264af7a6cc35f66b54eedb%2F2026-09-theastergates-atownsend-dsf2256.jpg" sizes="(min-width: 1350px) 953px, (min-width: 1025px) calc(100vw - 395px), (min-width: 768px) calc(100vw - 60px), calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fcc%2F04%2Fade23f264af7a6cc35f66b54eedb%2F2026-09-theastergates-atownsend-dsf2256.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fcc%2F04%2Fade23f264af7a6cc35f66b54eedb%2F2026-09-theastergates-atownsend-dsf2256.jpg" class="img" alt="Theaster Gates poses for a portrait at the Pickard China factory in Antioch, Ill. The 53-year-old Chicago-based artist recently acquired the business for an undisclosed sum." fetchpriority="high" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Theaster Gates poses for a portrait at the Pickard China factory in Antioch, Ill. The 53-year-old, Chicago-based artist recently acquired the business for an undisclosed sum.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Akilah Townsend for NPR                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;The &lt;a href="https://www.pickardchina.com/" target="_blank"&gt;&lt;u&gt;Pickard China&lt;/u&gt;&lt;/a&gt; factory in Antioch, Illinois, about 50 miles northwest of Chicago, is a cavernous space full of hulking, noisy, clay-splattered machines. The decorating room smells strongly of turpentine. The company's team of gilders mixes the chemical in with the pigments they use to handpaint plates, cups and other high-end porcelain homewares.&lt;/p&gt;   &lt;p&gt;"I don't even notice the smell," said employee Rachael Keeling, while deftly applying a narrow green band to a spinning porcelain plate destined for a golf club awards ceremony. "How crazy is that?"&lt;/p&gt;   &lt;div id="resg-s1-145508" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 4500;         --source-height: 3375;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/1800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/400/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/900/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/1200/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x3375+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F4c%2Fa6%2F42082556418a909c72342dfd8f19%2F2026-09-theastergates-atownsend-dsf2141-2.jpg" class="img" alt="A blonde woman dips a paintbrush into green paint and paints a small white china plate." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Rachael Keeling is among a small group of British craftspeople employed at Pickard. She said she came to the U.S. to work for the company 25 years ago.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Akilah Townsend for NPR                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Keeling is among a small group of British craftspeople employed at Pickard. She said she came to the U.S. to work for the company 25 years ago from the famed Wedgwood factory in Stoke-on-Trent when fine china production in her home country started becoming more automated and moving overseas. Keeling said she's still worried about her future. "I came here and it's like, 'Oh, is it going to happen again?' "&lt;/p&gt;       &lt;h3 class="edTag"&gt;A long decline&lt;/h3&gt;   &lt;p&gt;There used to be a handful of companies manufacturing high-end china in the U.S. Pickard is the last one left.&lt;/p&gt;   &lt;p&gt;Its customers include the White House, U.S. embassies, fancy hotels, private jets, golf clubs, and higher-end retailers like &lt;a href="https://www.williams-sonoma.com/products/pickard-signature-salad-plate/?Kenshoo=_k_Cj0KCQjwzsjVBhC3ARIsALnMv4nWBWsO3Nh2mYkv7yRLOT7nZzSVu5iUbzJ0KxJzQFLISpIe9seaoVEaAhGaEALw_wcB_k_&amp;cm_ven=NonBrandSearch&amp;cm_cat=Google&amp;cm_pla=NonBrand_Search_DSA&amp;cm_ite=_286186465_dsa-21652325160&amp;prof=404&amp;camp=19675&amp;kct=google&amp;kchid=802&amp;criteriaid=dsa-21652325160&amp;campaignid=286186465&amp;locphy=9031945&amp;adgroupid=19642455745&amp;adpos=&amp;cid=615906617486&amp;networkType=search&amp;kdv=c&amp;kext=&amp;kadtype=&amp;kmc=&amp;kpid=&amp;npclid=Cj0KCQjwzsjVBhC3ARIsALnMv4nWBWsO3Nh2mYkv7yRLOT7nZzSVu5iUbzJ0KxJzQFLISpIe9seaoVEaAhGaEALw_wcB&amp;ken_s2s=31862&amp;gad_source=1&amp;gad_campaignid=286186465&amp;gbraid=0AAAAAD_CuNt6Z-CimPgdUa_tmhCBs4S8-&amp;gclid=Cj0KCQjwzsjVBhC3ARIsALnMv4nWBWsO3Nh2mYkv7yRLOT7nZzSVu5iUbzJ0KxJzQFLISpIe9seaoVEaAhGaEALw_wcB" target="_blank"&gt;&lt;u&gt;Williams-Sonoma&lt;/u&gt;&lt;/a&gt;. "It's a beautiful, beautiful service," said Michelle Obama's interior designer, Michael Smith, of the blue-green rimmed dinnerware set he and the former First Lady commissioned from Pickard during her husband's second term in office. "It also lends itself to being used in convenient, flexible, and practical way."&lt;/p&gt;   &lt;div id="resg-s1-145509" class="bucketwrap image x-large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 8801;         --source-height: 6601;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fa1%2Fc6%2Ff8cd3fad42f587b0aa1606a05c1b%2F2026-09-theastergates-atownsend-dsf2213.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fa1%2Fc6%2Ff8cd3fad42f587b0aa1606a05c1b%2F2026-09-theastergates-atownsend-dsf2213.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fa1%2Fc6%2Ff8cd3fad42f587b0aa1606a05c1b%2F2026-09-theastergates-atownsend-dsf2213.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fa1%2Fc6%2Ff8cd3fad42f587b0aa1606a05c1b%2F2026-09-theastergates-atownsend-dsf2213.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fa1%2Fc6%2Ff8cd3fad42f587b0aa1606a05c1b%2F2026-09-theastergates-atownsend-dsf2213.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/8801x6601+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fa1%2Fc6%2Ff8cd3fad42f58