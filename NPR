lt/strip/false/crop/4032x3024+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG" sizes="(min-width: 1300px) 1238px, (min-width: 1025px) calc(100vw - 60px), (min-width: 768px) calc(100vw - 60px), calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/400/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/1000/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG 1000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/1300/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG 1300w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/2000/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG 2000w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/2600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG 2600w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG" sizes="(min-width: 1300px) 1238px, (min-width: 1025px) calc(100vw - 60px), (min-width: 768px) calc(100vw - 60px), calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5d%2Fa4%2Fda87682f4b4e963a85f1dd2f71b2%2Fgaza-04.JPEG" class="img" alt="A Palestinian mother is embraced by another woman as mourns her son, who was killed in an Israeli airstrike just over a month into the ceasefire, at Al-Shifa Hospital, in Gaza City, on November 20, 2025." fetchpriority="high" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 A Palestinian mother mourns her son, who was killed in an Israeli airstrike just over a month into the ceasefire, at Al-Shifa Hospital, in Gaza City, on Nov. 20, 2025.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Anas Baba/NPR                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;&lt;strong&gt;&lt;em&gt;Editor's note: &lt;/em&gt;&lt;/strong&gt;&lt;em&gt;This story contains graphic images of violence and death.&lt;/em&gt;&lt;/p&gt;   &lt;p&gt;GAZA STRIP — President Donald Trump promised an end to Israel's war in Gaza after he pushed Israel to agree to a ceasefire and Hamas to release remaining Israeli hostages. The deal came into effect on Oct. 10, 2025.&lt;/p&gt;   &lt;p&gt;A year later, however, there's still no international peacekeeping force in Gaza as promised and no reconstruction. Instead, Israel's military has expanded its control to roughly 70% of Gaza, squeezing more than 2 million Palestinians near the sea's edge.&lt;/p&gt;   &lt;p&gt;Israel has also continued targeting Hamas throughout the ceasefire. Those attacks have killed more than 1,400 Palestinians this past year, nearly 500 of them women and children, according to Gaza's Health Ministry.&lt;/p&gt;       &lt;p&gt;Although the bombings have not stopped, they have slowed down during the ceasefire.&lt;/p&gt;   &lt;p&gt;That has given people in Gaza a chance to recover from what U.N.-backed experts declared was a famine in the north of the territory last year. More food is now entering, reversing starvation across Gaza.&lt;/p&gt;   &lt;p&gt;NPR's reporter in Gaza, Anas Baba, has been capturing moments of respite and continuous grief over the past 12 months of the ceasefire. Below are a selection of his photos.&lt;/p&gt;   &lt;div id="resg-s1-146503" class="bucketwrap image x-large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 4032;         --source-height: 3024;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4032x3024+0+0/resize/400/quality/85/format/webp/?url=h