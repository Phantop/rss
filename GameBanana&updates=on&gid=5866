      <guid isPermaLink="false">3653fb847dc3278be97ed385374c4c5520e623be</guid>
      <pubDate>Sun, 04 Oct 2026 04:32:00 +0000</pubDate>
      <description>&lt;img src="https://images.gamebanana.com/img/ss/mods/6a92a6383fce9.jpg"/&gt;&lt;img src="https://images.gamebanana.com/img/ss/mods/6a92a649c3582.jpg"/&gt;&lt;img src="https://images.gamebanana.com/img/ss/mods/6a92a77150b9f.jpg"/&gt;&lt;img src="https://images.gamebanana.com/img/ss/mods/6a92a771ce587.jpg"/&gt;&lt;img src="https://images.gamebanana.com/img/ss/mods/6a92a7721466b.jpg"/&gt;&lt;img src="https://images.gamebanana.com/img/ss/mods/6a92a7723807c.jpg"/&gt;&lt;br&gt;&lt;strong&gt;Update:&lt;/strong&gt; Icons!&lt;br&gt;&lt;em&gt;Addition&lt;/em&gt;: Added weapon/shield icons&lt;br&gt;&lt;hr&gt;&lt;br&gt;&lt;h1&gt;Yet Another Golden Master Sword + Hylian Shield&lt;/h1&gt;&#13;
