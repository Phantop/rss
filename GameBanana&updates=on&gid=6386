      <media:content url="https://files.gamebanana.com/mods/worldactordroplimit.rar" type="application/vnd.rar"/>
      <media:content url="https://files.gamebanana.com/mods/generalitemlimit_cf547.rar" type="application/vnd.rar"/>
      <media:content url="https://files.gamebanana.com/mods/more_inventory_-_raw.rar" type="application/vnd.rar"/>
