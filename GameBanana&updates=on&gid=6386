    <item>
      <title>Increased Inventory Slots + World Drop Limit</title>
      <author>Catzy123</author>
      <link>https://gamebanana.com/mods/701786</link>
      <comments>https://gamebanana.com/mods/701786#PostsListModule</comments>
      <guid isPermaLink="false">9614c3fca8c1f7259285d1a9f044a6e3c31b8ea7</guid>
