pr-brightspot.s3.amazonaws.com%2Fb2%2F42%2F1bc8b7b14ed3867d91b7d729571e%2Fgettyimages-1128776044.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/6048x3404+0+620/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb2%2F42%2F1bc8b7b14ed3867d91b7d729571e%2Fgettyimages-1128776044.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/6048x3404+0+620/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb2%2F42%2F1bc8b7b14ed3867d91b7d729571e%2Fgettyimages-1128776044.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/6048x3404+0+620/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb2%2F42%2F1bc8b7b14ed3867d91b7d729571e%2Fgettyimages-1128776044.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/6048x3404+0+620/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb2%2F42%2F1bc8b7b14ed3867d91b7d729571e%2Fgettyimages-1128776044.jpg" class="img" alt="A &amp;quot;Route 66&amp;quot; sign is painted on the asphalt near Amboy in the Mojave Desert in California on Feb. 27, 2019." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 A "Route 66" sign is painted on the asphalt near Amboy in the Mojave Desert in California on Feb. 27, 2019.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Eric Baradat/&lt;br&gt;AFP via Getty Images&lt;br&gt;&lt;br&gt;                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Route 66 is celebrating an incredible century as America's most iconic highway. Stretching across eight states — from the vibrant streets of Chicago to the sun-soaked shores of Santa Monica, Calif. — this legendary route invites you to embrace the spirit of adventure on the open road. Imagine cruising through vast plains, rolling prairies, stunning canyons and shimmering deserts. Along the way, you'll discover a mix of big cities, charming cow towns and ghost towns. Over the decades, Route 66 has inspired countless songs, been captured in books, been seen in artwork and been celebrated in Pixar's 2006 animated movie &lt;em&gt;Cars&lt;/em&gt;. So hop in, buckle up and experience the magic of Route 66 &lt;a href="https://www.npr.org/2026/11/13/nx-s1-5927452/route-66-pop-culture" target="_blank"&gt;through these photos&lt;/a&gt;.&lt;/p&gt;   &lt;h3 class="edTag"&gt;3 things to know before you go&lt;/h3&gt;   &lt;div id="resg-s1-153834" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 5062;         --source-height: 2847;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/600/quality/