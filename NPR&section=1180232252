1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7008x3942+0+730/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F80%2F90%2Fb02c4a6c41399f6a7b78decc00a0%2Fbitinit-appleharvest-072726-andreastarr-54.JPG" class="img" alt="BitinIt_AppleHarvest_072726_AndreaStarr-54.JPG" loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;         &lt;/div&gt;       &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Apple farmers across the Pacific Northwest are ripping out thousands of acres of orchards and grinding trees into mulch because growing the fruit no longer pays. Many say they're being crushed by soaring labor and equipment costs and international tariffs. Even multigenerational growers are leaving land unused rather than hemorrhaging money. Thousands of acres of fruit have been left to rot unpicked on branches, pushing some well-established farms into bankruptcy. Federal farm relief has also largely failed to reach specialty-crop growers. Take a look at &lt;a href="https://www.npr.org/sections/the-picture-show/2026/11/24/g-s1-154620/how-high-costs-are-squeezing-apple-producers" target="_blank"&gt;photos and videos of affected farms&lt;/a&gt;, and read more about how the region that supplies the majority of the U.S.' fresh apples is handling the challenge.&lt;/p&gt;   &lt;h3 class="edTag"&gt;3 things to know before you go&lt;/h3&gt;   &lt;div id="resg-s1-155951" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 3771;         --source-height: 2121;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3771x2121+0+196/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F7e%2F7a%2F1a6382db43319335b6d467adbb6b%2Fgettyimages-2306395777.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3771x2121+0+196/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F7e%2F7a%2F1a6382db43319335b6d467adbb6b%2Fgettyimages-2306395777.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3771x2121+0+196/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F7e%2F7a%2F1a6382db43319335b6d467adbb6b%2Fgett