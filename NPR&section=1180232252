ormat/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff1%2F58%2Fa5ad2fbe4885be94763f638069b5%2Faz3y1564-1.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4670x2627+0+243/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff1%2F58%2Fa5ad2fbe4885be94763f638069b5%2Faz3y1564-1.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4670x2627+0+243/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff1%2F58%2Fa5ad2fbe4885be94763f638069b5%2Faz3y1564-1.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4670x2627+0+243/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff1%2F58%2Fa5ad2fbe4885be94763f638069b5%2Faz3y1564-1.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4670x2627+0+243/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff1%2F58%2Fa5ad2fbe4885be94763f638069b5%2Faz3y1564-1.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4670x2627+0+243/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Ff1%2F58%2Fa5ad2fbe4885be94763f638069b5%2Faz3y1564-1.jpg" class="img" alt="Best in Show star coonhound Rocker struts his stuff at the National Dog Show; Greater Philadelphia Expo Center; Nov. 14 and 15." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Best in Show star coonhound Rocker struts his stuff at the National Dog Show; Greater Philadelphia Expo Center; Nov. 14 and 15.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          &lt;i&gt;Steve Donahue for The National Dog Show.&lt;/i&gt;&lt;br&gt;                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;ol class="edTag"&gt;&lt;li&gt;Rocker the coonhound has &lt;a href="https://www.npr.org/2026/11/26/nx-s1-6054881/2026-national-dog-show-coonhound-rocker" target="_blank"&gt;won best in show&lt;/a&gt; at this year's National Dog Show. His glossy coat and big, floppy ears bested six other dogs that each won top honors in their groups.&lt;/li&gt;&lt;li&gt;When Dungeons &amp; Dragons came on the scene 50 years ago, some parents complained it kept their kids holed up inside. These days, the once-nerdy pastime is a &lt;a href="http://npr.org/nx-s1-6042445" target="_blank"&gt;screen-free parent's dream&lt;/a&gt;.&lt;/li&gt;&lt;li&gt;Bakers across the country have taken inspiration from Little Free Libraries to &lt;a href="https://www.npr.org/2026/11/25/nx-s1-6005522/little-free-bakery-austin-community-connection" target="_blank"&gt;offer free sweet treats&lt;/a&gt; to their neighbors.&lt;/li&gt;&lt;/ol&gt;   &lt;p&gt;This newsletter was edited by &lt;a href="https://www.npr.org/people/1155154221/majd-al-waheidi"target="_blank"   &gt;Majd Al-Waheidi&lt;/a&gt;.&lt;/p&gt; &lt;/div&gt;</description>
