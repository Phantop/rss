y/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/900/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/1200/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg" class="img" alt="When Lee Krasner was asked in a 1978 interview what she was doing while her husband Jackson Pollock was becoming so famous, she said, &amp;quot;I was working all the time.&amp;quot; Krasner is shown above, at work, in 1981." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 When Lee Krasner was asked in a 1978 interview what she was doing while her husband Jackson Pollock was becoming so famous, she said, "I was working all the time." Krasner is shown above, at work, in 1981.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Ernst Haas/Getty Images                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;The Metropolitan Museum of Art's new blockbuster exhibition showcases the works of two 20th-century artists. Jackson Pollock is well-known for his drip paintings. His wife, Lee Krasner, has often been overshadowed by her husband. This show finally gives Krasner the recognition she deserves. With more than 120 pieces on display — 74 from Krasner and 48 from Pollock — the show highlights Krasner as a titan of Abstract Expressionism, too. Check out some of the &lt;a href="https://www.npr.org/2026/10/10/nx-s1-5920376/lee-krasner-jackson-pollock-met" target="_blank"&gt;photos from the exhibit&lt;/a&gt;.&lt;/p&gt;   &lt;h3 class="edTag"&gt;3 things to know before you go&lt;/h3&gt;   &lt;div id="resg-s1-147769" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 7794;         --source-height: 4384;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/1800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/400/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/900/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/1200/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/7794x4384+0+0/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F26%2F78%2Fddfdc1d243f09e93115d2fbd57d2%2Fgettyimages-2299286819.jpg" class="img" alt="U.S. economists Robert E. Hall and Michael Woodford are announced as the winners of the 2026 Nobel prize in economics at the Royal Swedish Academy of Sciences in Stockholm on Monday." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 U.S. economists Robert E. Hall and Michael Woodford are announced as the winners of the 2026 Nobel prize in economics at the Royal Swedish Academy of Sciences in Stockholm on Monday.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Jonathan Nackstrand/AFP via Getty Images                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;ol class="edTag"&gt;&lt;li&gt;Americans Robert Hall from Stanford University and Michael Woodford from Columbia University have &lt;a href="https://www.npr.org/2026/10/09/nx-s1-5996634/nobel-prize-in-economics" target="_blank"&gt;won the Nobel Memorial Prize in Economic Sciences&lt;/a&gt; for their work on managing boom-and-bust cycles to reduce inflation and unemployment.&lt;/li&gt;&lt;li&gt;Trump's new press secretary, Katie Zacharia, will hold &lt;a href="https://www.npr.org/2026/10/12/nx-s1-5998948/new-white-house-press-secretary-a-devoted-fan-of-trump-and-maga" target="_blank"&gt;her first press briefing today&lt;/a&gt;. She has raised her profile by appearing on conservative outlets and promoting right-wing conspiracy theories.&lt;/li&gt;&lt;li&gt;Hectic early-morning traffic can make breakfast a luxury in Lagos, Nigeria. Akara is &lt;a href="https://www.npr.org/2026/07/25/nx-s1-5894904/breakfast-in-nigeria-akara" target="_blank"&gt;a roadside staple&lt;/a&gt;. For NPR's Breakfast Around the World series, Emmanuel Akinwotu explores the savory snack's deep roots in Nigeria and West Africa, and its spread around the world during the trans-Atlantic slave trade.&lt;/li&gt;&lt;/ol&gt;   &lt;p&gt;&lt;em&gt;This newsletter was edited by &lt;/em&gt;&lt;a href="https://www.npr.org/people/859721331/suzanne-nuyen"target="_blank"   &gt;&lt;em&gt;Suzanne Nuyen&lt;/em&gt;&lt;/a&gt;&lt;em&gt;.&lt;/em&gt;&lt;/p&gt; &lt;/div&gt;</description>
