F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4f%2F56%2F780b10f04562af1b3d88378e203d%2Fabdelrahman-elgendy-credit-fadel-dawod-1.png" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2000x1125+0+223/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4f%2F56%2F780b10f04562af1b3d88378e203d%2Fabdelrahman-elgendy-credit-fadel-dawod-1.png" class="img" alt="Abdelrahman ElGendy won the Non-fiction award at the National Book Awards for his memoir, Huna." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Abdelrahman ElGendy won the Non-fiction award at the National Book Awards for his memoir, &lt;em&gt;Huna.&lt;/em&gt;                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Fadel Dawod/National Book Foundation                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;ol class="edTag"&gt;&lt;li&gt;Abdelrahman ElGendy has won the &lt;a href="https://www.npr.org/2026/11/19/nx-s1-6037553/huna-writer-wins-national-book-award-for-non-fiction-after-not-being-allowed-into-the-u-s" target="_blank"&gt;National Book Awards' non-fiction prize&lt;/a&gt; for his memoir, &lt;em&gt;Huna&lt;/em&gt;, which recounts his six years as a political prisoner in Egypt.&lt;/li&gt;&lt;li&gt;"Choosin' Texas" singer Ella Langley &lt;a href="https://www.npr.org/2026/11/19/nx-s1-6045598/country-music-awards-honors-dolly-parton-ella-langley-wins-entertainer-of-the-year" target="_blank"&gt;won six of the seven categories&lt;/a&gt; she was nominated for, including song of the year, at the Country Music Awards.&lt;/li&gt;&lt;li&gt;In this week's edition of Far-Flung Postcards, NPR's Esme Nicholson sends &lt;a href="https://www.npr.org/2026/11/18/nx-s1-6043021/berlin-kollwitzplatz-statue" target="_blank"&gt;greetings from a Berlin square&lt;/a&gt;, where children play around a Käthe Kollwitz bronze cast. In the wake of World War I, the German artist's work often portrayed undernourished children in their mothers' arms.&lt;/li&gt;&lt;/ol&gt;   &lt;p&gt;&lt;em&gt;This newsletter was edited by &lt;/em&gt;&lt;a href="https://www.npr.org/people/859721331/suzanne-nuyen"target="_blank"   &gt;&lt;em&gt;Suzanne Nuyen&lt;/em&gt;&lt;/a&gt;&lt;em&gt;.&lt;/em&gt;&lt;/p&gt; &lt;/div&gt;</description>
