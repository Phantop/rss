12.5px; flex-grow: 0; margin-right: 14px; margin-left: 2px;"&gt;&lt;/div&gt; &lt;div style="background-color: #F4F4F4; border-radius: 50%; height: 12.5px; width: 12.5px; transform: translateX(9px) translateY(-18px);"&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style="margin-left: 8px;"&gt; &lt;div style=" background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 20px; width: 20px;"&gt;&lt;/div&gt; &lt;div style=" width: 0; height: 0; border-top: 2px solid transparent; border-left: 6px solid #f4f4f4; border-bottom: 2px solid transparent; transform: translateX(16px) translateY(-4px) rotate(30deg)"&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style="margin-left: auto;"&gt; &lt;div style=" width: 0px; border-top: 8px solid #F4F4F4; border-right: 8px solid transparent; transform: translateY(16px);"&gt;&lt;/div&gt; &lt;div style=" background-color: #F4F4F4; flex-grow: 0; height: 12px; width: 16px; transform: translateY(-4px);"&gt;&lt;/div&gt; &lt;div style=" width: 0; height: 0; border-top: 8px solid #F4F4F4; border-left: 8px solid transparent; transform: translateY(-4px) translateX(8px);"&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt; &lt;div style="display: flex; flex-direction: column; flex-grow: 1; justify-content: center; margin-bottom: 24px;"&gt; &lt;div style=" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 224px;"&gt;&lt;/div&gt; &lt;div style=" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; width: 144px;"&gt;&lt;/div&gt;&lt;/div&gt;&lt;/a&gt;&lt;p style=" color:#c9c8cd; font-family:Arial,sans-serif; font-size:14px; line-height:17px; margin-bottom:0; margin-top:8px; overflow:hidden; padding:8px 0 7px; text-align:center; text-overflow:ellipsis; white-space:nowrap;"&gt;&lt;a href="https://www.instagram.com/reel/DfCkeatlU4w/?utm_source=ig_embed&amp;amp;utm_campaign=loading" style=" color:#c9c8cd; font-family:Arial,sans-serif; font-size:14px; font-style:normal; font-weight:normal; line-height:17px; text-decoration:none;" target="_blank"&gt;A post shared by NPR (@npr)&lt;/a&gt;&lt;/p&gt;&lt;/div&gt;&lt;/blockquote&gt; &lt;script async src="//www.instagram.com/embed.js"&gt;&lt;/script&gt;    &lt;/div&gt;     &lt;!-- END ID="RESNX-S1-6022233-103" CLASS="BUCKETWRAP STATICHTML" --&gt;    &lt;p&gt;&lt;strong&gt;Steve Inskeep:&lt;/strong&gt; "I want to highlight Ryan Dunlap. He is a member of Trump's coalition who is concerned about rising prices at his hardware store in rural Stokes County, N.C. He generally votes conservative and can't see how you can run a business without being conservative. However, this posed a conflict for him as he needed to focus on the candidates and make a decision.&lt;/p&gt;   &lt;p&gt;There are also people in the Trump coalition who are sticking with the Republican Party. In particular, I think of a Marietta, Ga., voter who said Americans have a problem with delayed gratification. She felt that long-term things would get better, but that sentiment acknowledges that &lt;a href="http://one.npr.org/i/nx-s1-6022232:x" target="_blank"&gt;&lt;u&gt;things are not going well&lt;/u&gt;&lt;/a&gt; for many Americans right now."&lt;/p&gt;   &lt;p&gt;&lt;strong&gt;Michel Martin:&lt;/strong&gt; "In Springfield, Ohio, the president made wild false accusations about Haitians that were almost immediately debunked. But Trump doubled down on this same argument. This made me wonder whether it might backfire, as many residents expressed heightened motivation to vote as a message to the administration.&lt;/p&gt;       &lt;p&gt;I went to Michigan, where many were excited about flipping the Senate, but not everyone was happy with how campaigns were conducted. Many Black voters in the state felt dissatisfied with how the Democratic Party treated them. Some Jewish voters express skepticism about the Senate nominee, while others are upset by the campaign's tone, which they see as leaning into bigoted tropes."&lt;/p&gt;   &lt;p&gt;&lt;strong&gt;&lt;em&gt;Read and listen to all of Morning Edition's reporting on the road to the midterm on the NPR app. You'll find all of the hosts' stories from this month, plus &lt;/em&gt;&lt;/strong&gt;&lt;em&gt;playlists, podcast episodes, videos and more, all on the &lt;/em&gt;&lt;a href="https://npr.app/stqe/election-2026" target="_blank"&gt;&lt;em&gt;&lt;u&gt;2026 Election tab&lt;/u&gt;&lt;/em&gt;&lt;/a&gt;&lt;em&gt;. You can also subscribe to the &lt;/em&gt;&lt;a href="https://www.npr.org/newsletter/news" target="_blank"&gt;&lt;em&gt;&lt;u&gt;Up First Newsletter&lt;/u&gt;&lt;/em&gt;&lt;/a&gt;&lt;em&gt; for &lt;/em&gt;more midterm election analysis and updates.&lt;/p&gt;   &lt;p&gt;&lt;em&gt;The radio interview was produced by &lt;/em&gt;&lt;a href="https://www.npr.org/people/896256272/lilly-quiroz" target="_blank"&gt;&lt;em&gt;&lt;u&gt;Lilly Quiroz&lt;/u&gt;&lt;/em&gt;&lt;/a&gt;&lt;em&gt; and &lt;/em&gt;&lt;a href="https://www.npr.org/people/968488759/ziad-buchh" target="_blank"&gt;&lt;em&gt;&lt;u&gt;Ziad Buchh&lt;/u&gt;&lt;/em&gt;&lt;/a&gt;&lt;em&gt; and edited by &lt;/em&gt;&lt;a href="https://www.npr.org/people/896515920/simone-popperl" target="_blank"&gt;&lt;em&gt;&lt;u&gt;Simone Popperl&lt;/u&gt;&lt;/em&gt;&lt;/a&gt;&lt;em&gt; and &lt;/em&gt;&lt;a href="https://www.npr.org/people/360134258/arezou-rezvani" target="_blank"&gt;&lt;em&gt;&lt;u&gt;Arezou Rezvani&lt;/u&gt;&lt;/em&gt;&lt;/a&gt;&lt;em&gt;. The digital version was edited by &lt;/em&gt;&lt;a href="https://www.npr.org/people/1233191864/treye-green" target="_blank"&gt;&lt;em&gt;&lt;u&gt;Treye Green&lt;/u&gt;&lt;/em&gt;&lt;/a&gt;&lt;em&gt;.&lt;/em&gt;&lt;br&gt;&lt;/p&gt; &lt;/div&gt;</description>
