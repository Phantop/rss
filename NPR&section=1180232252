spot.s3.amazonaws.com%2F3e%2Fa5%2F406685634c73a582ad680acd20db%2Fgettyimages-2220014397.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x2531+0+234/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F3e%2Fa5%2F406685634c73a582ad680acd20db%2Fgettyimages-2220014397.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x2531+0+234/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F3e%2Fa5%2F406685634c73a582ad680acd20db%2Fgettyimages-2220014397.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4500x2531+0+234/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F3e%2Fa5%2F406685634c73a582ad680acd20db%2Fgettyimages-2220014397.jpg" class="img" alt="South African human rights lawyer Navi Pillay, 2026 Nobel Peace Prize laureate, arrives for a news conference in Geneva on June 18, 2025." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 South African human rights lawyer Navi Pillay, 2026 Nobel Peace Prize laureate, arrives for a news conference in Geneva on June 18, 2025.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          &lt;i&gt;Fabrice Coffrini&lt;/i&gt;/AFP via Getty Images                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;ol class="edTag"&gt;&lt;li&gt;The Norwegian Nobel Committee has &lt;a href="https://www.npr.org/2026/10/09/nx-s1-5994952/norwegian-nobel-committee-awards-this-years-peace-prize" target="_blank"&gt;awarded this year's Nobel Peace Prize&lt;/a&gt; to human rights lawyer Navanethem "Navi" Pillay. Pillay, who has served as the U.N. human rights chief and a judge on the International Court of Justice, was recognized for her contributions to international justice.&lt;/li&gt;&lt;li&gt;Three astronauts and a cosmonaut from NASA's SpaceX Crew-12 mission have &lt;a href="https://www.npr.org/2026/10/08/nx-s1-5992845/nasa-spacex-crew-12-international-space-station-iss-splashdown" target="_blank"&gt;returned to Earth&lt;/a&gt; after an almost eight-month trip to the International Space Station, where they conducted spacewalks, science experiments and research.&lt;/li&gt;&lt;li&gt;New research reveals surprising &lt;a href="https://www.npr.org/2026/10/07/nx-s1-5987874/ancient-gut-microbiome-migration-evolution-hadza-tsimane" target="_blank"&gt;similarities in the gut microbiomes&lt;/a&gt; of Tanzanian hunter-gatherers and Bolivian horticulturalists, suggesting that their microbial kinship dates back long before human migration separated their ancestors.&lt;/li&gt;&lt;/ol&gt;       &lt;p&gt;&lt;em&gt;This newsletter was edited by &lt;/em&gt;&lt;a href="https://www.npr.org/people/859721331/suzanne-nuyen"target="_blank"   &gt;&lt;em&gt;Suzanne Nuyen&lt;/em&gt;&lt;/a&gt;&lt;em&gt;.&lt;/em&gt;&lt;/p&gt; &lt;/div&gt;</description>
