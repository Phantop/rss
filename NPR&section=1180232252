bp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F89%2F46%2Fa89c6fec406cb45f180f451bd5f1%2F261118-lk-travelingrpkg-dig-1.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5333x3000+0+0/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F89%2F46%2Fa89c6fec406cb45f180f451bd5f1%2F261118-lk-travelingrpkg-dig-1.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5333x3000+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F89%2F46%2Fa89c6fec406cb45f180f451bd5f1%2F261118-lk-travelingrpkg-dig-1.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5333x3000+0+0/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F89%2F46%2Fa89c6fec406cb45f180f451bd5f1%2F261118-lk-travelingrpkg-dig-1.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5333x3000+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F89%2F46%2Fa89c6fec406cb45f180f451bd5f1%2F261118-lk-travelingrpkg-dig-1.jpg" class="img" alt="A vector illustration of a sad depressed frustrated traveler leaning on luggage." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 Holiday travel can be stressful. Make a plan for potential flight disruptions with these tips.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Aleksei Morozov/Getty Images                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Traveling by air for the holidays? AAA forecasts that nearly 6 million travelers will be flying this Thanksgiving, making it essential to know how to handle flight cancellations or delays. Travel experts have &lt;a href="https://www.npr.org/2026/11/18/nx-s1-6045636/got-a-canceled-flight-7-clever-ways-to-get-rebooked-fast" target="_blank"&gt;shared tips with &lt;em&gt;Life Kit&lt;/em&gt;&lt;/a&gt; to make the rebooking process easier and ensure you won't miss your holiday celebrations.&lt;/p&gt;   &lt;ul class="edTag"&gt;&lt;li&gt;✈️ While in line for customer service, open the airline app to rebook yourself. This speeds up the process, which can make a big difference when hundreds of other passengers may be in the same situation.&lt;/li&gt;&lt;li&gt;✈️ If your travel credit card offers lounge access, use it for personalized customer service. If you lack access, consider buying an on-site day pass.&lt;/li&gt;&lt;li&gt;✈️ Ticket holders are entitled to a refund if the airline cancels their flight and they refuse alternative options such as later flights or travel vouchers.&lt;/li&gt;&lt;li&gt;✈️ Choose the early-morning flight when rebooking. It's your best chance to avoid delays or cancellations. First flights out have a lower risk of waiting for an incoming aircraft, since the aircraft is likely to have been at the airport overnight.&lt;/li&gt;&lt;/ul&gt;   &lt;p&gt;Are you traveling with a baby or toddler this holiday season? &lt;a href="https://www.npr.org/2024/03/05/1196978785/traveling-with-babies-and-toddlers-tips-tricks" target="_blank"&gt;Here is what you should pack&lt;/a&gt;. Subscribe to &lt;a href="https://www.npr.org/newsletter/life-kit" target="_blank"&gt;the &lt;em&gt;Life Kit&lt;/em&gt; newsletter&lt;/a&gt; for expert advice on love, money, relationships and more.&lt;/p&gt;       &lt;h3 class="edTag"&gt;3 things to know before you go&lt;/h3&gt;   &lt;div id="resg-s1-154399" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 970;         --source-height: 546;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/970x546+0+22/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F77%2F3b%2F1b7e973f4fbc840214141269612c%2Fabby-and-friend-1.JPG 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/970x546+0+22/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F77%2F3b%2F1b7e973f4fbc840214141269612c%2Fabby-and-friend-1.JPG 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/970x546+0+22/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F77%2F3b%2F1b7e973f4fbc840214141269612c%2Fabby-and-friend-1.JPG 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/970x546+0+22/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F77%2F3b%2F1b7e973f4fbc840214141269612c%2Fabby-and-friend-1.JPG 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/970x546+0+22/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F77%2F3b%2F1b7e973f4fbc840214141269612c%2Fabby-and-friend-1.JPG 1200w, htt