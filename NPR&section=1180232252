ims3/default/strip/false/crop/5472x3078+0+282/resize/600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fbe%2F3e%2F812d039d41f29656f9b92aed1411%2Fap20100194370143.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5472x3078+0+282/resize/800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fbe%2F3e%2F812d039d41f29656f9b92aed1411%2Fap20100194370143.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5472x3078+0+282/resize/900/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fbe%2F3e%2F812d039d41f29656f9b92aed1411%2Fap20100194370143.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5472x3078+0+282/resize/1200/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fbe%2F3e%2F812d039d41f29656f9b92aed1411%2Fap20100194370143.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5472x3078+0+282/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fbe%2F3e%2F812d039d41f29656f9b92aed1411%2Fap20100194370143.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5472x3078+0+282/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fbe%2F3e%2F812d039d41f29656f9b92aed1411%2Fap20100194370143.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5472x3078+0+282/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fbe%2F3e%2F812d039d41f29656f9b92aed1411%2Fap20100194370143.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5472x3078+0+282/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fbe%2F3e%2F812d039d41f29656f9b92aed1411%2Fap20100194370143.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5472x3078+0+282/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fbe%2F3e%2F812d039d41f29656f9b92aed1411%2Fap20100194370143.jpg" class="img" alt="The Fed&amp;#039;s interest rate hike is bound to raise borrowing costs across the economy — but it&amp;#039;s intended to help bring down inflation." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 The Fed's interest rate hike is bound to raise borrowing costs across the economy — but it's intended to help bring down inflation.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          LM Otero/AP                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Earlier this month, the Federal Reserve raised interest rates a quarter percentage point, aiming to slow the acceleration of inflation. But how does that actually work? &lt;a href="https://www.npr.org/2026/09/19/nx-s1-5969816/federal-reserve-interest-rate-inflation-economy" target="_blank"&gt;Here's a clearer explanation&lt;/a&gt;.&lt;/p&gt;   &lt;ul class="edTag"&gt;&lt;li&gt;💵 The Fed raises its interest rate in hopes of triggering a domino effect across the economy that pushes up borrowing costs. The main goal is to cool prices by encouraging people and businesses to spend more carefully.&lt;/li&gt;&lt;li&gt;💵 When the Fed is worried about the labor market, it cuts interest rates to boost consumer spending and investment.&lt;/li&gt;&lt;li&gt;💵 The small rate hike won't significantly affect the economy, but it comes as many borrowing costs are rising.&lt;/li&gt;&lt;/ul&gt;   &lt;h3 class="edTag"&gt;Weekend picks&lt;/h3&gt;   &lt;div id="resg-s1-144492" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 1920;         --source-height: 1080;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1920x1080+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fc2%2F64%2Fd25c89dd4cc499cfe858f1acaf0a%2Fseptember-games.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1920x1080+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fc2%2F64%2Fd25c89dd4cc499cfe858f1acaf0a%2Fseptember-games.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1920x1080+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fc2%2F64%2Fd25c89dd4cc499cfe858f1acaf0a%2Fseptember-games.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1920x1080+0+0/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fc2%2F64%2Fd25c89dd4cc499cfe858f1acaf0a%2Fseptember-games.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1920x1080+0+0/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fc2%2F64%2Fd25c89dd4cc499cfe858f1acaf0a%2Fseptember-games.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/1920x1080+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fc2%2F64%2Fd25c89dd4cc499cfe858f1acaf0a%2F