ightspot.s3.amazonaws.com%2Fd7%2F50%2F5a1c89c54c488843f09812a09fe3%2Fweather-keeper-interior-v9-5.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2050x1154+882+1770/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fd7%2F50%2F5a1c89c54c488843f09812a09fe3%2Fweather-keeper-interior-v9-5.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2050x1154+882+1770/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fd7%2F50%2F5a1c89c54c488843f09812a09fe3%2Fweather-keeper-interior-v9-5.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2050x1154+882+1770/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fd7%2F50%2F5a1c89c54c488843f09812a09fe3%2Fweather-keeper-interior-v9-5.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2050x1154+882+1770/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fd7%2F50%2F5a1c89c54c488843f09812a09fe3%2Fweather-keeper-interior-v9-5.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2050x1154+882+1770/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fd7%2F50%2F5a1c89c54c488843f09812a09fe3%2Fweather-keeper-interior-v9-5.jpg" class="img" alt="Weather Keeper_Interior_v9_5.jpg" loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;         &lt;/div&gt;       &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Nelly Buchet's new picture book,&lt;em&gt; The Weather Keeper&lt;/em&gt;, was inspired by a woman who runs one of Iceland's 71 manned weather stations. The story follows a daughter as she decides whether to return to her small town or forge a new path in the city, with illustrator Elizabeth Haidle capturing the rhythms of a weather keeper's daily life. See &lt;a href="https://www.npr.org/2026/09/13/nx-s1-5902250/the-weather-keeper-nelly-buchet-elizabeth-haidle" target="_blank"&gt;photos from the book&lt;/a&gt;.&lt;/p&gt;   &lt;h3 class="edTag"&gt;3 things to know before you go&lt;/h3&gt;   &lt;div id="resg-s1-143103" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 3231;         --source-height: 1817;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb3%2Fd1%2F12cb5e554d49be949447d540b0d6%2Fap26255714607289.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3231x1817+0+0/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-