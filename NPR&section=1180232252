f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5097x2867+0+265/resize/600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F6f%2F5c%2F3f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5097x2867+0+265/resize/800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F6f%2F5c%2F3f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5097x2867+0+265/resize/900/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F6f%2F5c%2F3f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5097x2867+0+265/resize/1200/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F6f%2F5c%2F3f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5097x2867+0+265/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F6f%2F5c%2F3f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5097x2867+0+265/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F6f%2F5c%2F3f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5097x2867+0+265/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F6f%2F5c%2F3f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5097x2867+0+265/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F6f%2F5c%2F3f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5097x2867+0+265/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F6f%2F5c%2F3f346e034949b36cd4c8b40fa6ce%2Fgettyimages-2299455893.jpg" class="img" alt="President Trump leaves the stage after speaking during an election rally at in Syracuse, New York on Oct. 9, 2026." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 President Trump leaves the stage after speaking during an election rally in Syracuse, New York on Oct. 9, 2026.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Alex Wong/Getty Images                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;&lt;strong&gt;Trump has ramped up his campaign travel ahead of the midterm elections. &lt;/strong&gt;He rallied supporters in Youngstown, Ohio, last night and is heading to Alaska today. More events are planned for later this week. He has been trying to encourage his supporters to vote by telling them to pretend he is on the ballot.&lt;br&gt;&lt;/p&gt;       &lt;ul class="edTag"&gt;&lt;li&gt;🎧&lt;strong&gt; Trump's events resemble his presidential campaign rallies: &lt;/strong&gt;He emphasizes his accomplishments while calling out superfans and insulting Democrats, NPR's Danielle Kurtzleben tells &lt;em&gt;Up First&lt;/em&gt;. Kurtzleben adds that Trump's campaign trail &lt;a href="http://one.npr.org/i/nx-s1-5999968:x" target="_blank"&gt;emphasizes that the GOP is still his party&lt;/a&gt;, despite his declining approval. Candidates like Ohio GOP gubernatorial candidate Vivek Ramaswamy and GOP Sen. Jon Husted saw large, appreciative, but Kurtzleben says the benefits of appearing alongside Trump remain unclear.&lt;/li&gt;&lt;li&gt;➡️ &lt;strong&gt;With just weeks until Election Day&lt;/strong&gt;, polls may start to flood the landscape. While they serve as a helpful tool, remember they can't predict the future. Keep these &lt;a href="https://www.npr.org/2026/10/13/nx-s1-5996916/2026-election-midterms-polls-horse-race" target="_blank"&gt;tips in mind as polls pour in&lt;/a&gt;.&lt;/li&gt;&lt;li&gt;➡️&lt;strong&gt; The NPR App has all of NPR's election coverage in one place&lt;/strong&gt; — from the biggest stories across the country, to the issues that matter close to home. Browse headlines, playlists, podcast episodes, videos and more, all on the &lt;a href="https://npr.app/stqe/election-2026" target="_blank"&gt;2026 Election tab&lt;/a&gt;.&lt;/li&gt;&lt;/ul&gt;   &lt;p&gt;&lt;strong&gt;Federal agents searched Rep. Ilhan Omar's home in Washington, D.C.&lt;/strong&gt;, yesterday morning. Omar, D-Minn., says the search was politically motivated by the Trump administration. The Department of Justice told NPR in a statement that Homeland Security Investigations agents "executed a judicially authorized search warrant," approved by the DOJ, as part of an ongoing federal investigation. Current and former federal officials with knowledge of the search who were not authorized to speak publicly confirmed the details, revealing that this multi-year probe includes whistleblower complaints and focuses on &lt;a href="https://www.npr.org/2026/10/12/nx-s1-5998856/federal-agents-search-congressperson-home-dc-doj" target="_blank"&gt;allegations of immigration fraud&lt;/a&gt;.&lt;br&gt;&lt;/p&gt;       &lt;aside id="mid-story-recommendations-mount-piano" class="mid-story-recommendations-mount-piano" aria-label="recommended stories"&gt;&lt;/aside&gt;    &lt;!-- END ID="MID-STORY-RECOMMENDATIONS-MOUNT-PIANO" CLASS="MID-STORY-RECOMMENDATIONS-MOUNT-PIANO" ARIA-LABEL="RECOMMENDED STORIES" --&gt;    &lt;ul class="edTag"&gt;&lt;li&gt;🎧&lt;strong&gt; One of Omar's neighbors, 79-year-old Sharon Jackson, tells NPR's Luke Garrett she was awoken&lt;/strong&gt; yesterday at around 4:30 a.m. by loud knocking and that vans and agents wearing gloves were walking to and from the congresswoman's house. Vice President JD Vance previously accused Omar of immigration fraud, which she denies. Omar is an American citizen who left Somalia as a refugee. She stated on social media that the president has &lt;a href="http://one.npr.org/i/nx-s1-5999968:x" target="_blank"&gt;spent a decade targeting her&lt;/a&gt; with smear campaigns and vowed not to be silenced. Trump says that he is not involved in the investigation into Omar.&lt;/li&gt;&lt;/ul&gt;   &lt;h3 class="edTag"&gt;Living better&lt;/h3&gt;   &lt;div id="resg-s1-145576" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 2070;         --source-height: 1164;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/1800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/400/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/900/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/1200/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/2070x1164+0+285/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Ffa%2Fdb%2F61048f5f431c95b6b2afcef73760%2Fgettyimages-1572895908.jpg" class="img" alt="The safest way to protect yourself from measles when traveling is to be vaccinated." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 The safest way to protect yourself from measles when traveling is to be vaccinated.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Malte Mueller/Getty Images                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;&lt;em&gt;Living Better is a &lt;/em&gt;&lt;a href="https://www.npr.org/series/1176326550/living-better" target="_blank"&gt;&lt;em&gt;special series&lt;/em&gt;&lt;/a&gt;&lt;em&gt; about what it takes to stay healthy in America.&lt;/em&gt;&lt;/p&gt;   &lt;p&gt;The U.S. is experiencing its worst measles resurgence in decades. More than 3,600 confirmed cases and two deaths have been reported as of late September. Outbreaks in several states and exposures in public places like bars, sports stadiums and public transit have raised concerns about travel safety. Almost all U.S. measles cases involve unvaccinated individuals, and as the outbreaks grow in some states, the risk of exposure is getting higher. Here's what to know &lt;a href="https://www.npr.org/2026/09/30/nx-s1-5978940/traveling-measles-exposure-vaccines-transportation" target="_blank"&gt;before traveling by plane or train&lt;/a&gt;.&lt;br&gt;&lt;/p&gt;   &lt;ul class="edTag"&gt;&lt;li&gt;✈️ People who've had two doses of the MMR vaccine are considered protected against measles.&lt;/li&gt;&lt;li&gt;✈️ The disease is highly contagious. It spreads through the air when an infected person coughs, breathes or sneezes. That airspace can remain contaminated for up to two hours.&lt;/li&gt;&lt;li&gt;✈️ Check with your healthcare provider about your vaccination status. They may recommend a booster based on your medical history and health.&lt;/li&gt;&lt;li&gt;✈️ Immunocompromised individuals may be unable to receive vaccination and often rely on herd immunity for protection. For measles, the vaccination threshold for herd immunity is 95%.&lt;/li&gt;&lt;li&gt;✈️ Measles can be hard to track because symptoms — such as fever, cough, and rash — typically appear seven to 14 days after exposure and can sometimes take long as 21 days to surface.&lt;/li&gt;&lt;/ul&gt;       &lt;h3 class="edTag"&gt;Picture show&lt;/h3&gt;   &lt;div id="resg-s1-147535" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 5819;         --source-height: 3271;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F5e%2Fe6%2Fcc4894c441a99b6eaae0eb7549cf%2Fgettyimages-488958535.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5819x3271+0+0/resize/800/quality/85/format/webp/?url=ht