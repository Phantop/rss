rl=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3840x2160+0+0/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3840x2160+0+0/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3840x2160+0+0/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3840x2160+0+0/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3840x2160+0+0/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3840x2160+0+0/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3840x2160+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3840x2160+0+0/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3840x2160+0+0/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F4e%2F0d%2F728b89154973a4e942ced4d58d36%2Fjason-and-lucia-03.jpg" class="img" alt="Grand Theft Auto VI protagonists, Lucia Caminos and Jason Duval, against the backdrop of the Miami-inspired Vice City." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 &lt;em&gt;Grand Theft Auto VI &lt;/em&gt;protagonists, Lucia Caminos and Jason Duval, against the backdrop of the Miami-inspired Vice City.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Rockstar Games                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;&lt;strong&gt;Check out what &lt;/strong&gt;&lt;a href="https://www.npr.org/sections/culture/" target="_blank"&gt;&lt;strong&gt;NPR&lt;/strong&gt;&lt;/a&gt;&lt;strong&gt; is watching, reading and listening to this weekend:&lt;/strong&gt;&lt;/p&gt;   &lt;p&gt;&lt;strong&gt;🍿 Movies: &lt;/strong&gt;&lt;a href="https://www.npr.org/2026/11/18/nx-s1-6043854/a-civil-rights-struggle-takes-center-stage-in-being-heumann" target="_blank"&gt;&lt;em&gt;Being Heumann&lt;/em&gt;&lt;/a&gt; chronicles Judy Heumann, the "mother of the disability rights movement," and her coalition as they embark on a historic 1970s sit-in to advocate for disability rights legislation.&lt;/p&gt;   &lt;p&gt;&lt;strong&gt;📺 TV:&lt;/strong&gt; In the new British comedy-fantasy &lt;a href="https://www.npr.org/2026/11/05/nx-s1-6029405/small-prophets-review" target="_blank"&gt;&lt;em&gt;Small Prophets&lt;/em&gt;&lt;/a&gt;, a man summons magical spirits in an attempt to locate his long-missing girlfriend.&lt;/p&gt;   &lt;p&gt;&lt;strong&gt;📚 Books:&lt;/strong&gt; Longtime host of &lt;em&gt;Reading Rainbow&lt;/em&gt; LeVar Burton shares his journey in his new memoir, &lt;a href="https://www.npr.org/2026/11/17/nx-s1-6043200/levar-burton-reading-rainbow-star-trek-roots-memoir" target="_blank"&gt;&lt;em&gt;Take My Word for It&lt;/em&gt;&lt;/a&gt;. He reflects on his life, both in and out of his iconic roles, and the unexpected twists he's encountered.&lt;/p&gt;   &lt;p&gt;&lt;strong&gt;🎵 Music:&lt;/strong&gt; On &lt;a href="https://www.npr.org/2026/11/17/nx-s1-6043831/mikaela-davis-album-graceland-way" target="_blank"&gt;&lt;em&gt;Graceland Way&lt;/em&gt;&lt;/a&gt;, singer-songwriter and harpist Mikaela Davis blends psychedelic and alternative country, showcasing her boundary-pushing harp play.&lt;/p&gt;   &lt;p&gt;&lt;strong&gt;🎮 Gaming:&lt;/strong&gt; After years of waiting, fans can now revel in the Bonnie-and-Clyde love story in &lt;a href="https://www.npr.org/2026/11/18/nx-s1-6040326/grand-theft-auto-6-review-vice-city-masterpiece" target="_blank"&gt;&lt;em&gt;Grand Theft Auto VI&lt;/em&gt;&lt;/a&gt;. The game is poised to steal the crown as the biggest entertainment launch ever with up to $5 billion in projected first-week sales, according to estimates.&lt;/p&gt;   &lt;p&gt;&lt;strong&gt;❓ Quiz:&lt;/strong&gt; What a week! A new James Bond was named, SpaceX made history and the Alaska Senate race was called. Think you were paying attention? &lt;a href="http://npr.org/2026/11/20/g-s1-154337/florida-starship-bond-schumer-ai-flu-alaska-news-quiz" target="_blank"&gt;Let's find out&lt;/a&gt;.&lt;/p&gt;       &lt;h3 class="edTag"&gt;3 things to know before you go&lt;/h3&gt;   &lt;div id="resg-s1-154205" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 3825;         --source-height: 2152;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3825x2152+0+0/resize/400/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F33%2Fa9%2F06089dc548abaaae295e93dc98ed%2Fap26296421881981.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3825x2152+0+0/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F33%2Fa9%2F06089dc548abaaae295e93dc98ed%2Fap26296421881981.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3825x2152+0+0/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F33%2Fa9%2F06089dc548abaaae295e93dc98ed%2Fap26296421881981.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3825x2152+0+0/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2F33%2Fa9%2F06089dc548abaaae295e93dc98ed%2Fap26296421881981.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3825x2152+0+0/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazona