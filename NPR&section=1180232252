pr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/900/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/1200/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/1600/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/1800/quality/85/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/1100/quality/50/format/webp/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/5062x2847+0+376/resize/{width}/quality/{quality}/format/{format}/?url=https%3A%2F%2Fnpr-production-npr.s3.us-east-1.amazonaws.com%2Fbrightspot%2Fb1%2F22%2Fdf2ccdf7425b9e9fd2adf7d753e0%2Fap25064678056736.jpg" class="img" alt="This illustration provided by NASA depicts Voyager 1." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 This illustration provided by NASA depicts Voyager 1.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          AP/NASA                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;ol class="edTag"&gt;&lt;li&gt;NASA's Voyager 1 has traveled farther than any human-launched object and is about to reach a new milestone: reaching a distance that's &lt;a href="https://www.npr.org/2026/11/15/nx-s1-6041716/a-long-long-ways-from-home-voyager-1-is-now-farther-than-anything-man-has-sent-into-space" target="_blank"&gt;one light-day away&lt;/a&gt; from Earth.&lt;/li&gt;&lt;li&gt;New Orleans port officials have filed a lawsuit against the owner and operator of the Atlantic Asphalt tanker that &lt;a href="https://www.npr.org/2026/11/15/nx-s1-6041677/new-orleans-port-sues-miracle-mississippi-cruise-ship" target="_blank"&gt;crashed into a docked cruise ship&lt;/a&gt; in the Mississippi River. They are seeking at least $1 million in damages.&lt;/li&gt;&lt;li&gt;Mauricio Pochettino, who guided the U.S. men's national soccer team to a Round of 16 finish in the 2026 FIFA World Cup, is leaving to become the &lt;a href="https://www.npr.org/2026/11/13/nx-s1-6038932/mauricio-pochettino-usmnt-manchester-united" target="_blank"&gt;head coach of Manchester United&lt;/a&gt; in the English Premier League.&lt;/li&gt;&lt;/ol&gt;   &lt;p&gt;&lt;em&gt;This newsletter was edited by &lt;/em&gt;&lt;a href="https://www.npr.org/people/859721331/suzanne-nuyen"target="_blank"   &gt;&lt;em&gt;Suzanne Nuyen&lt;/em&gt;&lt;/a&gt;&lt;em&gt;.&lt;/em&gt;&lt;/p&gt; &lt;/div&gt;</description>
