85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F78%2Fc5%2Feecbf8f0401f8e9d220536fbdd3c%2Flannaapisukh-npr-americangirl-5085.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2249+239+663/resize/1200/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F78%2Fc5%2Feecbf8f0401f8e9d220536fbdd3c%2Flannaapisukh-npr-americangirl-5085.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2249+239+663/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F78%2Fc5%2Feecbf8f0401f8e9d220536fbdd3c%2Flannaapisukh-npr-americangirl-5085.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2249+239+663/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F78%2Fc5%2Feecbf8f0401f8e9d220536fbdd3c%2Flannaapisukh-npr-americangirl-5085.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2249+239+663/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F78%2Fc5%2Feecbf8f0401f8e9d220536fbdd3c%2Flannaapisukh-npr-americangirl-5085.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2249+239+663/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F78%2Fc5%2Feecbf8f0401f8e9d220536fbdd3c%2Flannaapisukh-npr-americangirl-5085.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/4000x2249+239+663/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2F78%2Fc5%2Feecbf8f0401f8e9d220536fbdd3c%2Flannaapisukh-npr-americangirl-5085.jpg" class="img" alt="American Girl dolls of all eras on display at the store, September 24, 2026, New York, New York." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 American Girl dolls of all eras on display at the store, September 24, 2026, New York, New York.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          Lanna Apisukh for NPR                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;p&gt;Pleasant Rowland launched Pleasant Company in 1986 with three dolls — Samantha, Molly and Kirsten — creating an empire known as American Girl. To celebrate its 40th anniversary, author Fiona Davis was asked to write a historical fiction book for adults titled &lt;em&gt;Samantha: The Next Chapter&lt;/em&gt;, featuring Samantha Parkington, who has turned 25. The story picks up after Samantha's last book, in which she attended a suffragist rally with her aunt Cornelia. The book is set 15 years later, in 1920, just after the ratification of the 19th Amendment. Samantha learns that her grandmother's inheritance has been stolen, forcing her to transition from socialite to shopgirl overnight. NPR's Samantha Balaban visited the American Girl store in New York with her own Samantha doll to explore the character's evolution over the years, drawing on insights from its staff and Davis. Check out photos from the visit and read more about the &lt;a href="https://www.npr.org/2026/10/18/nx-s1-5711243/american-girl-40-samantha-fiona-davis" target="_blank"&gt;history of American Girl dolls&lt;/a&gt;.&lt;/p&gt;       &lt;h3 class="edTag"&gt;3 things to know before you go&lt;/h3&gt;   &lt;div id="resg-s1-148465" class="bucketwrap image large"&gt;             &lt;div     class="imagewrap has-source-dimensions"     data-crop-type=""     style="         --source-width: 3630;         --source-height: 2042;     " &gt;         &lt;picture&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/400/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/900/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/1200/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/1600/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/1800/quality/85/format/webp/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/webp" /&gt;             &lt;source srcset="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/400/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 400w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 800w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/900/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 900w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/1200/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 1200w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/1600/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 1600w, https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/1800/quality/85/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg 1800w" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg" sizes="(min-width: 1025px) 650px, calc(100vw - 30px)" class="img" type="image/jpeg" /&gt;             &lt;img src="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/1100/quality/50/format/jpeg/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg" data-template="https://npr.brightspotcdn.com/dims3/default/strip/false/crop/3630x2042+0+83/resize/{width}/quality/{quality}/format/{format}/?url=http%3A%2F%2Fnpr-brightspot.s3.amazonaws.com%2Fb6%2F34%2Fd9c3bde94f53b06e88c7599041d1%2Fgettyimages-151055685.jpg" class="img" alt="For the first time since 2014, the American College of Obstetricians and Gynecologists has updated its guidelines for the treatment of symptoms commonly associated with menopause." loading="lazy" /&gt;         &lt;/picture&gt; &lt;/div&gt; &lt;div class="credit-caption"&gt;     &lt;div class="caption-wrap"&gt;         &lt;div class="caption" aria-label="Image caption"&gt;             &lt;p&gt;                 For the first time since 2014, the American College of Obstetricians and Gynecologists has updated its guidelines for the treatment of symptoms commonly associated with menopause.                 &lt;b class="credit" aria-label="Image credit"&gt;                                          BSIP/Universal Images Group/Getty Images                                      &lt;/b&gt;                 &lt;b class="hide-caption"&gt;&lt;b&gt;&lt;/b&gt;&lt;/b&gt;             &lt;/p&gt;         &lt;/div&gt;               &lt;button class="toggle-caption" aria-label=""&gt;               &lt;svg class="icon icon--info"&gt;&lt;use href="#icon-info"&gt;&lt;/use&gt;&lt;/svg&gt;               &lt;b&gt;&lt;/b&gt;                 &lt;abbr title="Toggle Caption" class="toggle-caption__info"&gt;i&lt;/abbr&gt;              &lt;/button&gt;     &lt;/div&gt;       &lt;/div&gt;    &lt;/div&gt;    &lt;ol class="edTag"&gt;&lt;li&gt;The American College of Obstetricians and Gynecologists has &lt;a href="https://www.npr.org/2026/10/16/nx-s1-6005201/health-treatment-menopause-hot-flash-night-sweats-insomnia" target="_blank"&gt;updated its menopause treatment guidelines&lt;/a&gt; for the first time since 2014. The group now recommends using hormone replacement therapy along with some other treatments to alleviate symptoms.&lt;/li&gt;&lt;li&gt;A wedding day can be one of the costliest days in a couple's life. Some are &lt;a href="https://www.npr.org/2026/10/17/nx-s1-5976921/grocery-store-wedding-cakes" target="_blank"&gt;opting to save money&lt;/a&gt; by choosing grocery-store cakes over specialty bakers' cakes.&lt;/li&gt;&lt;li&gt;Vegemite is such an iconic breakfast spread in Australia that a convicted killer is suing the state of Victoria for the &lt;a href="https://www.npr.org/2026/08/02/nx-s1-5896064/breakfasts-around-the-world-in-australia-being-denied-vegemite-is-grounds-for-suing" target="_blank"&gt;right to eat it in prison&lt;/a&gt;. The state has banned Vegemite because it could potentially be used to brew alcohol and throw off dogs.&lt;/li&gt;&lt;/ol&gt;   &lt;p&gt;&lt;em&gt;This newsletter was edited by &lt;/em&gt;&lt;a href="https://www.npr.org/people/859721331/suzanne-nuyen"target="_blank"   &gt;&lt;em&gt;Suzanne Nuyen&lt;/em&gt;&lt;/a&gt;&lt;em&gt;.&lt;/em&gt;&lt;/p&gt; &lt;/div&gt;</description>
