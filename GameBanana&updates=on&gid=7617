    <item>
      <title>Prototype Champion's Leathers</title>
      <author>Mindstormman</author>
      <link>https://gamebanana.com/mods/730676</link>
      <comments>https://gamebanana.com/mods/730676#PostsListModule</comments>
      <guid isPermaLink="false">2f94f6eea0f8db71c5f45d88c097e35489f42fa8</guid>
