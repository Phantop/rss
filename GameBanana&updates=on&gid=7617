      <media:content url="https://files.gamebanana.com/mods/ultimate-ascend-v0160-switch.zip" type="application/zip"/>
      <media:content url="https://files.gamebanana.com/mods/ultimate-ascend-v0160-shrine-restricted-experimental-emulator.zip" type="application/zip"/>
