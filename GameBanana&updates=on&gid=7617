    <item>
      <title>Sunlight Greatsword</title>
      <author>Deano309</author>
      <link>https://gamebanana.com/mods/639656</link>
      <comments>https://gamebanana.com/mods/639656#PostsListModule</comments>
      <guid isPermaLink="false">89a82095c20b83a20c2b04224cccff7bf7ae7e38</guid>
      <pubDate>Thu, 29 Oct 2026 14:13:52 +0000</pubDate>
