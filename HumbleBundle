      <title>The Builder’s Vault by Hivemind - Unreal Engine Edition</title>
      <author>Laya Design</author>
      <link>https://humblebundle.com//software/builders-vault-hivemind-unreal-edition-software</link>
      <guid isPermaLink="false">059e55708851b22c401513bc138cd3c016eb875f</guid>
