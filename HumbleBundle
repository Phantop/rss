      <title>Gals and Pals: PQube Japanese Games</title>
      <author>PQube Limited</author>
      <link>https://humblebundle.com//games/gals-and-pals-pqube-japanese-games</link>
      <guid isPermaLink="false">16fd36c20aa72217ce7287536dab2008f4facdbd</guid>
