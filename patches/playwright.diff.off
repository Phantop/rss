@@ -160,6 +178,45 @@ class CssSelectorBridge extends BridgeAbstract
         return $title;
     }

+    /**
+     * Fetch a page either directly or through a rendered Chromium page.
+     *
+     * @param string $url Page URL
+     * @param bool $use_playwright Whether to render the page with Playwright
+     * @param bool $cached Whether to use RSS-Bridge's page cache for direct requests
+     * @return \simple_html_dom Page DOM
+     */
+    protected function getPageHtml($url, $use_playwright = false, $cached = false)
+    {
+        if (!$use_playwright) {
+            return $cached ? getSimpleHTMLDOMCached($url) : getSimpleHTMLDOM($url);
+        }
+
+        $context = null;
+        try {
+            $context = \Playwright\Playwright::chromium(['headless' => true]);
+            $page = $context->newPage();
+            $page->goto($url, ['waitUntil' => 'load']);
+            $html = $page->content();
+
+            if (empty($html)) {
+                throw new \RuntimeException('Playwright returned an empty page.');
+            }
+
+            return str_get_html($html);
+        } catch (\Throwable $e) {
+            throwClientException('Could not retrieve page with Playwright: ' . $e->getMessage());
+        } finally {
+            try {
+                if ($context !== null) {
+                    $context->close();
+                }
+            } catch (\Throwable $e) {
+                // The page-fetch error is more useful than a shutdown error.
+            }
+        }
+    }
+
