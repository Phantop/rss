+    /**
+     * Fetch a page directly, or through Browserless' content endpoint when configured.
+     */
+    protected function getPageDom($url, $cached = false)
+    {
+        if (empty($this->browserlessUrl)) {
+            return $cached ? getSimpleHTMLDOMCached($url) : getSimpleHTMLDOM($url);
+        }
+
+        $endpoint = $this->getBrowserlessContentEndpoint();
+        $content = getContents(
+            $endpoint,
+            ['Content-Type: application/json'],
+            [CURLOPT_POSTFIELDS => json_encode(['url' => $url])]
+        );
+
+        if ($content === '') {
+            throw new \Exception('Unable to parse dom because Browserless returned an empty response');
+        }
+
+        return str_get_html($content);
+    }
+
+    /**
+     * Build a Browserless content endpoint URL while retaining credentials in its query string.
+     */
+    protected function getBrowserlessContentEndpoint()
+    {
+        $urlParts = parse_url($this->browserlessUrl);
+        if (
+            $urlParts === false
+            || !in_array($urlParts['scheme'] ?? '', ['http', 'https'], true)
+            || empty($urlParts['host'])
+        ) {
+            throwClientException('Browserless URL must be an absolute HTTP(S) URL');
+        }
+
+        $path = rtrim($urlParts['path'] ?? '', '/');
+        if (!str_ends_with($path, '/content')) {
+            $path .= '/content';
+        }
+
+        $endpoint = $urlParts['scheme'] . '://';
+        if (isset($urlParts['user'])) {
+            $endpoint .= $urlParts['user'] . (isset($urlParts['pass']) ? ':' . $urlParts['pass'] : '') . '@';
+        }
+        $endpoint .= $urlParts['host'] . (isset($urlParts['port']) ? ':' . $urlParts['port'] : '') . $path;
+
+        $query = preg_replace('/(^|&)stealth=[^&]*/i', '$1', $urlParts['query'] ?? '');
+        $query = trim($query, '&');
+        return $endpoint . '?' . ($query === '' ? '' : $query . '&') . 'stealth=true';
+    }
+
