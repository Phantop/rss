diff --git c/tests/Ipv6AddressTest.php i/tests/Ipv6AddressTest.php
new file mode 100644
index 00000000..499e9803
--- /dev/null
+++ i/tests/Ipv6AddressTest.php
@@ -0,0 +1,18 @@
+<?php
+
+declare(strict_types=1);
+
+namespace RssBridge\Tests;
+
+use Ipv6Address;
+use PHPUnit\Framework\TestCase;
+
+class Ipv6AddressTest extends TestCase
+{
+    public function testAddressRanges()
+    {
+        $this->assertTrue(Ipv6Address::fromString('fc00::1')->isPrivate());
+        $this->assertTrue(Ipv6Address::fromString('::1')->isReserved());
+        $this->assertTrue(Ipv6Address::fromString('2001:4860:4860::8888')->isPublic());
+    }
+}
